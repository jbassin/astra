    "generate:routes": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/generate-routes.ts",
    "fetch:aon": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/fetch-aon.ts",
    "fetch:foundry": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/fetch-foundry.ts",
    "transform": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/transform.ts",
    "search:build": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/build-search.ts",
    "row-height-drift-guard": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/rowHeightDriftGuard.ts"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
