    "@tanstack/react-virtual": "^3.14.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "pagefind": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
