#!/bin/sh
# astra pre-commit gate — mirrors CI (format + lint, warnings treated as errors).
# Blocks the commit if anything is unclean; never modifies your files. Runs over
# the whole repo (both linters are fast), so it catches the same things CI does.
#
# Installed by the root package.json "prepare" script:
#   git config core.hooksPath .githooks   (runs on `bun install`)
# Bypass in a genuine emergency with:  git commit --no-verify
set -u
fail=0

run() {
  label=$1
  shift
  if ! "$@"; then
    echo "✖ pre-commit: $label failed" >&2
    fail=1
  fi
}

echo "pre-commit: biome (TS) + ruff (Python) …" >&2

# TypeScript lane: format + lint + import-sort, with warnings escalated to errors
# (this is what scoped local runs missed — see strider-0016-gotchas).
if command -v bunx >/dev/null 2>&1; then
  run "biome" bunx biome ci --error-on-warnings .
else
  echo "✖ pre-commit: bun not found (needed for the TS lane)" >&2
  fail=1
fi

# Python lane: lint + format check.
if command -v uv >/dev/null 2>&1; then
  run "ruff check" uv run ruff check .
  run "ruff format" uv run ruff format --check .
else
  echo "✖ pre-commit: uv not found (needed for the Python lane)" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "commit blocked. fix with:  bun run format  &&  uv run ruff format ." >&2
  echo "(emergency bypass:          git commit --no-verify)" >&2
  exit 1
fi
