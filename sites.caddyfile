# astra host-edge sites — imported by the shared reverse proxy at
# /ruby/data/reverse-proxy/Caddyfile (custom caddy binary w/ the cloudflare-dns
# plugin), the same way faerrin's sites.caddyfile is. Add this line to that file:
#   import /ruby/data/experiments/astra/sites.caddyfile
# (and drop faerrin's strider import — both can't own strider.iridi.cc at once).
#
# Decision I: frontends are SSR Compose services, REVERSE-PROXIED here (not the
# static `file_server` faerrin used). Reload with `just caddy-reload`.
#
# The Cloudflare ACME-DNS token is NOT committed: `{$CF_API_TOKEN}` is substituted
# at config-adapt time from the SOPS-decrypted value the reload command exports —
# so the token is never written to this file or to disk.

(astra_site) {
	tls {
		issuer acme {
			dns cloudflare {$CF_API_TOKEN}
			propagation_timeout 5m
			resolvers 1.1.1.1 8.8.8.8
		}
	}

	encode zstd gzip

	header -Server
	header -X-Powered-By
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options SAMEORIGIN
	header ?Strict-Transport-Security "max-age=31536000"
}

# NB: (local_only) — gate to private IPs — is already defined by the parent
# reverse-proxy Caddyfile; blocks here can `import local_only` directly (don't
# redeclare it, that collides on reload).

# strider — the first SSR frontend (more blocks follow as 0011-0013 ship). The
# compose `strider` service publishes host port 10360. It self-serves gothic's
# fonts from dist/ (site-kit's gothicFontsPlugin copies them in at build), so
# /fonts/* falls through to the reverse_proxy — no gothic_fonts import, matching
# orator/weal-overlay. 0011-0013 inherit this.
strider.iridi.cc {
	import astra_site

	# Editor UI — local network only (import local_only → "Access Denied" for
	# non-private clients). The save runs as a TanStack server function (POST to
	# /_serverFn/*, not a gateable path), so this gate is on the UI that invokes
	# it; the function is server-only and obscure, but not itself IP-restricted.
	@editor path /editor /editor/*
	handle @editor {
		import local_only
		reverse_proxy localhost:10360
	}

	handle {
		reverse_proxy localhost:10360
	}
}

# akasha-frontend — the wiki read-surface (0011), the second SSR frontend on the
# strider template. A read-only surface (no /editor), so no local_only gate. Like
# strider it self-serves gothic's fonts from dist/ (gothicFontsPlugin), so /fonts/*
# falls through to the reverse_proxy. /pagefind/* (the search index) is likewise just
# static under dist/client. Compose publishes host port 10365. (Needs an
# akasha.iridi.cc DNS record — manual, deferred like strider/orator/weal-overlay.)
akasha.iridi.cc {
	import astra_site
	reverse_proxy localhost:10365
}

# heart.iridi.cc — alias host for akasha-frontend (same SSR service, port 10365).
# (Needs a heart.iridi.cc DNS record — manual, like the other deferred hosts.)
heart.iridi.cc {
	import astra_site
	reverse_proxy localhost:10365
}

# mouthpiece-frontend — the podcast read-surface (0012), the third SSR frontend on the
# strider/akasha template. Read-only (no /editor → no local_only gate). Self-serves
# gothic's fonts from dist/; /audio/<id>.mp3 is served by the SSR process off the
# mounted audio volume (D2), so it falls through to the reverse_proxy like any other
# path. Compose publishes host port 10366. (Needs a mouthpiece.iridi.cc DNS record —
# manual, deferred like strider/akasha/orator/weal-overlay.)
mouthpiece.iridi.cc {
	import astra_site
	reverse_proxy localhost:10366
}

# harrow — the tarot deck reader (0017), a backend-less SSR frontend on the strider
# template (Decision I). Read-only (no editor); self-serves gothic's fonts from the
# container. Compose publishes host port 10369. The harrow.iridi.cc DNS record already
# exists (the old standalone deploy used it) — this block takes the host over; the old
# stanza was removed from the parent reverse-proxy Caddyfile (was → localhost:10204).
harrow.iridi.cc {
	import astra_site
	reverse_proxy localhost:10369
}

# ledger — the astra landing page (0018), the simplest SSR frontend, a sibling of
# harrow. One homepage: a gothic card grid linking the player-facing sites (the links
# are baked from each site's config public-origin at build time). Read-only (no
# editor → no local_only gate); self-serves gothic's fonts from the container. Compose
# publishes host port 10370. (Needs a ledger.iridi.cc DNS record — new subdomain.)
ledger.iridi.cc {
	import astra_site
	reverse_proxy localhost:10370
}

# vellum-frontend — the document-forge editor (0013), the fourth SSR frontend on the
# strider/akasha template. Two upstreams (D2, mirroring faerrin's old vellum block):
# /render + /health proxy to the vellum-render service (the PNG render sidecar), so the
# editor's export POSTs same-origin; everything else (the editor + preview) goes to the
# SSR frontend. The /editor UI is gated local_only (like strider) — the export still
# works for local clients; a public visitor sees the read-only landing page. Self-serves
# gothic's fonts from the container. Compose publishes 10367 (frontend) + 10368 (render).
# (Needs a vellum.iridi.cc DNS record — manual, deferred like the other frontends.)
vellum.iridi.cc {
	import astra_site

	# The PNG render API → the vellum-render service (warm Chromium, egress-blocked,
	# semaphore-gated). Same-origin so the editor needs no CORS / env var.
	@render path /render /health
	handle @render {
		reverse_proxy localhost:10368
	}

	# Editor UI — local network only (import local_only → "Access Denied" for
	# non-private clients). Same posture as strider's editor.
	@editor path /editor /editor/*
	handle @editor {
		import local_only
		reverse_proxy localhost:10367
	}

	handle {
		reverse_proxy localhost:10367
	}
}

# weal-overlay — the dice-roll OBS overlay (0009). SSE: flush_interval -1 disables
# response buffering so text/event-stream reaches OBS immediately. The overlay
# self-serves its fonts from dist/, so no gothic_fonts import. Compose publishes
# host port 10361. (Needs a weal-overlay.iridi.cc DNS record — manual, like strider.)
weal-overlay.iridi.cc {
	import astra_site
	reverse_proxy localhost:10361 {
		flush_interval -1
	}
}

# orator-backend — the Discord music console (0010): Bun.serve REST + the served
# operator SPA (one origin, M3). The SPA self-serves its gothic fonts from dist/
# (gothicFontsPlugin copies them in), so no gothic_fonts import. Auth is handled in
# the app (Discord OAuth + ontology allowlist), so no IP gate. Compose publishes
# host port 10363. (Needs an orator.iridi.cc DNS record — manual, like strider.)
orator.iridi.cc {
	import astra_site

	# SSE: the ingest job-progress stream (EventSource) needs unbuffered proxying
	# so text/event-stream reaches the browser immediately.
	@sse path /api/v1/ingest/jobs/*/events
	handle @sse {
		reverse_proxy localhost:10363 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:10363
	}
}

# OTLP/HTTP ingest for browser RUM (config.kdl telemetry.rum-endpoint points
# here). Reverse-proxies the SigNoz collector's host port; the collector has no
# CORS of its own, so reflect it here for *.iridi.cc frontends only.
otel.iridi.cc {
	import astra_site

	@preflight {
		method OPTIONS
		header_regexp Origin ^https://([a-z0-9-]+\.)?iridi\.cc$
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	@iridi header_regexp Origin ^https://([a-z0-9-]+\.)?iridi\.cc$
	handle @iridi {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Vary Origin
		reverse_proxy localhost:10353
	}

	handle {
		reverse_proxy localhost:10353
	}
}

# SigNoz UI — the observability single pane (deploy substrate). Local network
# only: import local_only denies non-private clients for the whole site.
signoz.iridi.cc {
	import astra_site
	import local_only
	reverse_proxy localhost:10351
}

# Dagster UI — the pipeline control plane (run/asset/sensor management). Internal
# admin surface, so local network only (import local_only). Compose's dagster-webserver
# publishes host port 10350. (Needs a dagster.iridi.cc DNS record — manual, like the
# other internal/outward-facing hosts.)
dagster.iridi.cc {
	import astra_site
	import local_only
	reverse_proxy localhost:10350
}
