          "marks": {
            "bold": false,
            "italic": false,
            "superscript": false
          }
        },
        {
          "display": "auditory",
          "kind": "crossref",
          "targetId": "trait/auditory"
        },
        {
          "content": " and ",
          "kind": "text",
          "marks": {
            "bold": false,
            "italic": false,
            "superscript": false
          }
        },
        {
          "display": "linguistic",
          "kind": "crossref",
          "targetId": "trait/linguistic"
        },
        {
          "content": " if you're conveying information verbally.",
          "kind": "text",
