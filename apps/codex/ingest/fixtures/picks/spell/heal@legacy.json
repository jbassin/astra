          "marks": {
            "bold": true,
            "italic": false,
            "superscript": false
          }
        },
        {
          "content": " The spell has a range of 30 feet. If you're healing a living creature, increase the Hit Points restored by 8.\n",
          "kind": "text",
          "marks": {
            "bold": false,
            "italic": false,
            "superscript": false
          }
        },
        {
          "cost": "Three Actions",
