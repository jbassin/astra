// astra config — the consolidated faerrin env inventory (roadmap Decision E).
//
// Plaintext config lives here as node args. Secrets are NEVER plaintext: a secret
// is a `ref="sops:KEY"` pointer whose value lives in deploy/sops/secrets.enc.yaml
// and is decrypted on demand by libs/{py,ts}/config. Defaults below are the faerrin
// code-defaults; deployment-specific values (URLs, paths) are set per-deploy via the
// env override (an env var named like the KEY, upper-cased) or by editing this file.

llm {
    default-model "claude-opus-4-8"
    default-max-tokens 16000
    anthropic-api-key ref="sops:anthropic_api_key"
}

telemetry {
    // In-cluster OTLP/HTTP receiver of the SigNoz collector. Astra services run as
    // Compose units on signoz-net and reach the collector by its container name
    // (:4318 = the collector's OTLP/HTTP port). The host-published port (10353) is
    // NOT reachable from inside a container, so this MUST be the in-cluster address
    // for server-side spans to land. A host-run/dev process (no container) can't
    // resolve this name — pass `endpoint=`/`{endpoint}` explicitly, or run in-cluster.
    otlp-endpoint "http://signoz-otel-collector:4318"
    // Public OTLP/HTTP endpoint the *browser* RUM posts spans to directly. The
    // server-side otlp-endpoint above is not browser-reachable in prod; this is
    // the Caddy-exposed collector (otel.iridi.cc → localhost:10353, with CORS).
    rum-endpoint "https://otel.iridi.cc"
}

scribe {
    // Craig zips land in incoming-path; each session is written to {data-path}/saved/{date}.
    // incoming-path is a LOCAL dir (bind-mounted into the Dagster services). The live
    // Craig recordings live on a google-drive-ocamlfuse mount, which Docker can't
    // bind-mount (FUSE isn't in the daemon's namespace) — so zips are copied here from
    // Drive (e.g. `cp /ruby/data/home/drive/Craig/*.zip apps/scribe/incoming/`, or a
    // host-side rclone sync). The craig_drop_sensor globs it for *.zip; keep-zip unused.
    data-path "/ruby/data/experiments/astra/apps/scribe/data"
    incoming-path "/ruby/data/experiments/astra/apps/scribe/incoming"
    tmp-path "/ruby/data/experiments/astra/apps/scribe/tmp"
    state-file ""
    downstream-cmd ""
    keep-zip #false
    skip-downstream #false
    // Transcription model — full litellm id (Decision G uses Groq Whisper, not whisperx).
    // scribe reads this and passes it to TrackTranscriber; this value is authoritative.
    model "groq/whisper-large-v3"
    device "cpu"
    compute-type "int8"
    groq-api-key ref="sops:groq_api_key"
}

linguist {
    ingest-source ""
    // INVARIANT: must equal scribe's {data-path}/saved — the scribe→linguist handoff
    // (scribe writes saved/{date}/script.json; the linguist sensor + ingest read it).
    ingest-saved-dir "/ruby/data/experiments/astra/apps/scribe/data/saved"
    review-port 10116
    podcast-episodes-path ""
    // Phase-2 judge models + Phase-1 filter / windowing tuning (faerrin `config.ts` `surface`).
    surface-model-judge "claude-haiku-4-5-20251001"
    surface-model-escalate "claude-sonnet-4-6"
    surface-max-ngram 3
    surface-min-token-len 3
    surface-known-floor-unigram 0.78
    surface-known-floor-multi 0.8
    surface-strong-score 0.88
    surface-known-near-floor 0.6
    surface-judge-chunk-size 150
    surface-judge-overlap 10
    surface-escalate-low 0.4
    surface-escalate-high 0.75
    surface-confidence-floor 0.6
    surface-judge-max-tokens 4096
}

mouthpiece {
    // Where the per-session asset graph writes (digest/script/clips/episode.mp3/
    // transcript.md per session) + the episodes_index asset globs. Host-absolute
    // under the repo, bind-mounted into the Dagster services at the same path (deploy/
    // docker-compose.yml). Empty would resolve to the cwd — set it so a real pipeline
    // run lands here. (NB the mouthpiece-FRONTEND audio volume is separate, D2.)
    episodes-path "/ruby/data/experiments/astra/apps/mouthpiece-backend/episodes"
    elevenlabs-api-key ref="sops:elevenlabs_api_key"
}

weal {
    // In-cluster addresses (Compose service DNS). The PG creds are the dev defaults
    // (match deploy/ POSTGRES_* defaults); prod overrides them at the Phase-6 cutover.
    database-url "postgres://weal:weal@weal-postgres:5432/weal"
    feed-ws-url "http://weal-overlay:10360/api/v1/roll"
    chart-base-url ""
    bind-addr "127.0.0.1:10203"
    players-path "players.toml"
    rust-log "info"
    discord-token ref="sops:weal_discord_key"
    feed-token ref="sops:weal_token"
    dice-feed-url ref="sops:dice_feed_url" // rotated webhook — added + resolved at cutover (Phase 6)
}

weal-overlay {
    port 10360
    token ref="sops:weal_token" // shared weal↔overlay secret
}

orator {
    guild-id "753007205510545469"
    spike-channel-id "1206675724090609714"
    // In-cluster Postgres (Compose service DNS); creds match deploy/ POSTGRES_*
    // defaults; prod overrides at the Phase-6 cutover. Library store (Decision F).
    database-url "postgres://orator:orator@orator-postgres:5432/orator"
    // Deploy values are the single source (config-single-source) — orator-backend
    // binds this port + origin directly; no PORT/env overrides. Behind Caddy at
    // orator.iridi.cc → host 10363.
    port 10363
    public-origin "https://orator.iridi.cc"
    // Audio + data dir = the Compose `orator-audio` volume mount (read by both the
    // service and the migrator; no ORATOR_DATA_DIR env).
    data-dir "/data"
    allowed-user-ids ""
    target-lufs -16
    ingest-concurrency 2
    measure-loudness #true
    discord-token ref="sops:orator_discord_key"
    discord-client-id ref="sops:orator_discord_client_id"
    discord-client-secret ref="sops:orator_discord_client_secret"
    session-secret ref="sops:orator_session_secret"
}

orator-controller {
    api-key ref="sops:orator_controller_api_key"
}

strider {
    // The SSR frontend service (Decision I) — the template for 0011-0013. Deploy
    // values are the single source (config-single-source): server.ts binds this
    // port + names telemetry with service-name; no PORT env. Behind Caddy at
    // strider.iridi.cc → host 10360. service-name also derives the browser RUM
    // service name (`{service-name}-rum`).
    service-name "astra.strider"
    port 10360
}

akasha-frontend {
    // The akasha wiki read-surface (0011) — an SSR frontend on the strider
    // template (Decision I). Same config-single-source contract as strider:
    // server.ts binds this port + names telemetry; no PORT env. Behind Caddy at
    // akasha.iridi.cc → host 10365. service-name derives the browser RUM name
    // (`{service-name}-rum`). public-origin = the absolute base URL baked into
    // the build-emitted RSS/sitemap/og links (the Quartz ContentIndex contract).
    service-name "astra.akasha-frontend"
    port 10365
    public-origin "https://akasha.iridi.cc"
}

mouthpiece-frontend {
    // The podcast read-surface (0012) — an SSR frontend on the strider/akasha
    // template (Decision I). Same config-single-source contract: server.ts binds
    // this port + names telemetry; no PORT env. Behind Caddy at mouthpiece.iridi.cc
    // → host 10366. service-name derives the browser RUM name (`{service-name}-rum`).
    // public-origin = the absolute base URL baked into the build-emitted
    // /episodes.json deep-link map (the wiki/Discord contract). NB: distinct from
    // `mouthpiece` (the backend) — this is the frontend.
    service-name "astra.mouthpiece-frontend"
    port 10366
    public-origin "https://mouthpiece.iridi.cc"
    // The in-container dir the episode audio volume mounts at (D2). The SSR server
    // serves `<audio-dir>/<id>.mp3` same-origin at /audio/<id>.mp3 — the 173 MB of
    // seeded audio is a runtime volume, never baked into the image (Decision I).
    audio-dir "/audio"
}

vellum-frontend {
    // The PF2e document forge (0013) — the editor read/write surface, an SSR frontend
    // on the strider/akasha template (Decision I). Same config-single-source contract:
    // server.ts binds this port + names telemetry; no PORT env. Behind Caddy at
    // vellum.iridi.cc → host 10367. service-name derives the browser RUM name
    // (`{service-name}-rum`). public-origin = the absolute base URL (the share-link
    // origin + the host the render service is reached same-origin under). The PNG
    // export POSTs same-origin to /render, which Caddy routes to vellum-render (10368).
    service-name "astra.vellum-frontend"
    port 10367
    public-origin "https://vellum.iridi.cc"
}

vellum-render {
    // The PNG render service (0013) — a Bun.serve + Playwright sidecar (warm Chromium,
    // per-request isolated contexts, egress-blocked, semaphore-gated). Same
    // config-single-source contract: the server binds this port + names telemetry; no
    // PORT env. The editor reaches it same-origin via Caddy (vellum.iridi.cc/render →
    // host 10368). A SEPARATE Compose unit from vellum-frontend (D2).
    service-name "astra.vellum-render"
    port 10368
}

caddy {
    cloudflare-dns-token ref="sops:cloudflare_key"
}
