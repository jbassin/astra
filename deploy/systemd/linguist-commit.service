[Unit]
Description=Auto-commit + push new linguist transcripts/data (pipeline source-of-record) for astra
Documentation=https://github.com/jbassin/astra
# Class C alerting: page Discord directly on failure (e.g. a push that keeps failing). The
# handler decrypts the webhook from SOPS at runtime. %n = linguist-commit.service.
OnFailure=astra-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/ruby/data/experiments/astra
# `just` lives in the user's cargo bin. The recipe stages apps/linguist/{transcripts,data}
# — which the Dagster run workers write to the host via bind mounts — then commits + pushes
# to origin/main. Runs as the user (not in a container) so it has the real .git, the git
# identity, and the SSH push key; the Dagster containers have none of those.
ExecStart=/home/jbassin/.cargo/bin/just linguist-commit
