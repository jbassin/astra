# astra edge — production reverse proxy / static server (roadmap Decision H).
#
# The REAL Caddyfile is GITIGNORED because the production one embeds a Cloudflare
# DNS token for ACME DNS-01 (faerrin gotcha). Copy this to ./Caddyfile and fill in.
# A minimal local-dev Caddyfile (plain :80, no TLS) is what the compose mounts.
#
# {
# 	email you@example.com
# 	# acme_dns cloudflare {env.CF_API_TOKEN}
# }

# --- SSR frontends (Decision I — reverse-proxied Compose services, NOT static dist/) ---
# strider is the template: the SSR server owns the site's root paths; Caddy
# reverse-proxies it and gates the /editor authoring write path. 0011-0013
# (akasha-fe / mouthpiece-fe / vellum-fe) follow this same block.
# strider.iridi.cc {
# 	encode zstd gzip
# 	# Authoring write path — restrict before exposing (basicauth / IP allow / mTLS).
# 	@write path /write-layer
# 	handle @write {
# 		# basic_auth { editor $2a$14$...bcrypt... }
# 		reverse_proxy strider-editor:3001
# 	}
# 	# Optionally gate the editor UI too:
# 	# @editor path /editor*
# 	# handle @editor { basic_auth { editor $2a$14$... } reverse_proxy strider:10360 }
# 	reverse_proxy strider:10360
# }

# --- Service UIs / APIs (reverse-proxied to Compose services) ---
# signoz.iridi.cc {
# 	reverse_proxy signoz:8080
# }
# dagster.iridi.cc {
# 	reverse_proxy dagster-webserver:3000
# }
# orator.iridi.cc {
# 	reverse_proxy orator-backend:PORT
# }
