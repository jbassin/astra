{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/being.canonical.json",
      "!**/akasha-snapshot.json",
      "!**/fixtures/vellum/**",
      "!**/tests/fixtures/**",
      "!**/linguist/data/**",
      "!**/routeTree.gen.ts",
      "!**/src/generated/**",
      "!**/public/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "useBiomeIgnoreFolder": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["**/vellum-lang/src/vss.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off", "useTemplate": "off" } } }
    },
    {
      "includes": ["**/gothic/src/render/**"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      "includes": [
        "**/strider/src/lib/hexUtils.ts",
        "**/strider/src/lib/hexUtils.test.ts",
        "**/strider/src/lib/layers.test.ts",
        "**/strider/src/lib/memoriam.ts",
        "**/strider/src/lib/memoriam.test.ts",
        "**/strider/src/lib/timeline.ts",
        "**/strider/src/lib/useFocusTrap.ts",
        "**/strider/src/lib/editorHelpers.ts",
        "**/strider/src/components/HexMap/**",
        "**/strider/src/components/MapView/MapView.tsx",
        "**/strider/src/components/Editor/**"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["**/strider/src/components/FactionDetail/FactionDetail.tsx"],
      "linter": { "rules": { "security": { "noDangerouslySetInnerHtml": "off" } } }
    },
    {
      "includes": [
        "**/strider/src/components/Modal/Modal.tsx",
        "**/strider/src/components/FactionSymbol/FactionSymbol.tsx",
        "**/strider/src/components/MapView/OverlayStrip.tsx",
        "**/strider/src/components/MapView/TimelineStrip.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useAriaPropsSupportedByRole": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      "includes": ["**/weal-overlay/test/hub.test.ts", "**/weal-overlay/test/server.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": [
        "**/orator-backend/src/web/ui/Dialog.tsx",
        "**/orator-backend/src/web/ui/TagEditModal.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
