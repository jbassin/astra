{
  "alert": "astra no new mouthpiece episode",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "description": "The newest episode render is {{$value}} days old (limit 21). Check the Dagster mouthpiece assets for the latest transcript.",
    "summary": "no new mouthpiece episode for {{$value}} days"
  },
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "disabled": false,
            "legend": "episode",
            "name": "A",
            "query": "max(astra_data_newest_age_seconds{\"service.name\"=\"node-exporter\", dataset=\"episode\"}) / 86400"
          },
          "type": "promql"
        }
      ],
      "queryType": "promql"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "discord-ops"
          ],
          "matchType": "at_least_once",
          "name": "warning",
          "op": "above",
          "recoveryTarget": null,
          "target": 21,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "No new mouthpiece episode render (mouthpiece/episodes/<date>/*.episode.mp3) for 21 days. Not every session gets an episode: between 2026-06-18 and 2026-10-19 the longest gap between episodes was 18 days (2026-09-17 to 2026-10-05), so 21 days is past anything seen. Source: astra-ops host-metrics.",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "5m"
    }
  },
  "labels": {
    "host": "saffron"
  },
  "notificationSettings": {
    "groupBy": [],
    "renotify": {
      "alertStates": [
        "firing"
      ],
      "enabled": true,
      "interval": "24h"
    }
  },
  "ruleType": "promql_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
