{
  "name": "@astra/menhir",
  "version": "0.0.0",
  "private": true,
  "description": "menhir — a Kahoot-style session-opener quiz. Host screen + phone shape buttons, timed MCQ, speed scoring, no auth (R4).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import ../../../libs/ts/site-kit/src/nodeTsResolve.mjs --watch server.ts",
    "build": "vite build && tsdown --config-loader tsx",
    "preview": "vite preview",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/service-kit": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@fontsource/cinzel": "catalog:",
    "@fontsource/cormorant-sc": "catalog:",
    "@fontsource/eb-garamond": "catalog:",
    "@fontsource/oswald": "catalog:",
    "@opentelemetry/api": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "srvx": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/qrcode": "^1.5.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "menhir"
  }
}
