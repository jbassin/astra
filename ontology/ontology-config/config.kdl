// astra config — the consolidated faerrin env inventory (roadmap Decision E).
//
// Plaintext config lives here as node args. Secrets are NEVER plaintext: a secret
// is a `ref="sops:KEY"` pointer whose value lives in deploy/sops/secrets.enc.yaml
// and is decrypted on demand by libs/{py,ts}/config. Defaults below are the faerrin
// code-defaults; deployment-specific values (URLs, paths) are set per-deploy via the
// env override (an env var named like the KEY, upper-cased) or by editing this file.
//
// Each language's loader validates only the blocks its apps read and ignores the rest;
// one CI test validates every block (libs/py/config `WholeConfig`). The models.py
// docstring there lists which language reads which block.

data {
    // Every data path in this file (each service's own state paths: scribe.data-path,
    // mouthpiece.episodes-path, heartwood.requests-path, ...) is relative to `root`,
    // and the published datasets below to `content-root`; astra_config resolves them to
    // absolute paths at load, so code only ever sees absolute paths. An absolute value is
    // used as-is. Moving the data = changing these values plus the identical-path bind
    // mounts in deploy/docker-compose.yml (container path = resolved path, so this baked
    // file means the same thing everywhere). ASTRA_DATA_ROOT overrides `root` (a test and
    // dev seam; the host scripts read the same variable for the same root).
    //
    // All runtime data lives under `root`, never in a code checkout (0037 Phase 1 item 2c):
    // one flat dir per service. deploy/deploy.sh init_artifacts creates the uid-1000 dirs
    // (keep it in step with this list):
    //   astra-data/              the astra-data clone (content-root, below)
    //   scribe/incoming/         Craig zips, copied down from Drive by craig-sync
    //   scribe/data/             scribe output; saved/<date>/ is the scribe -> linguist handoff
    //   scribe/tmp/              scribe scratch
    //   linguist/script/         linguist operator state (the campaign-matched context)
    //   mouthpiece/episodes/     the episode corpus: per-session renders + .last-rendered
    //   mouthpiece/experiments/  producer and roundtable runs (0034)
    //   heartwood/               per-run agent artifacts, backfill.log, backfill.lock
    //   heartwood/requests/      the Dagster <-> host request files (0036), logs/ inside
    //   codex/data/              codex corpus, Pagefind index, AoN + Foundry snapshots
    //   menhir/                  menhir results.jsonl
    //   audio/{akasha,mouthpiece,orator}/  audio the frontends and orator serve
    //   postgres/{dagster,orator,weal}/    PGDATA (uid 70, mode 0700, set by the postgres entrypoint)
    //   portal-oauth/            portal's OAuth state
    //   node-exporter/textfile/  smartmon.prom (smart-exporter writes, node-exporter serves)
    //   deploy/                  deploy.lock, history.jsonl, live/<service> (deploy.sh)
    //   locks/                   git-publish.lock (linguist-commit + the heartwood recipes)
    //                            and host-tooling.lock (deploy.sh venv sync vs. heartwood runs)
    root "/ruby/data/astra-state"
    // The astra-data clone (github jbassin/astra-data): the pipeline's published
    // datasets, committed and pushed by the bots (linguist-commit, heartwood) — the code
    // repo tracks none of them. A relative value is under `root`. The eight datasets
    // below are relative to THIS root, in the astra-data layout. ASTRA_CONTENT_ROOT
    // overrides it (the same variable the frontends' build-content reads).
    content-root "astra-data"
    linguist-transcripts "linguist/transcripts"
    linguist-data "linguist/data"
    linguist-timeline "linguist/timeline"
    mouthpiece-snapshot "mouthpiece/snapshot"
    akasha-content "akasha/content"
    akasha-snapshot "akasha/snapshot"
    heartwood-ledger "heartwood/agent-runs.jsonl"
    entity-registry "entity/entity.kdl"
}

llm {
    // Every LLM call routes through OpenRouter (GLM, DeepSeek); a model id is a full
    // litellm `provider/model` string, passed straight through.
    // litellm reads each provider key from its UPPER_CASED env var, injected from SOPS
    // at `just up` (per-service compose `environment:`).
    default-model "openrouter/z-ai/glm-5.2"
    openrouter-api-key ref="sops:openrouter_api_key"
}

telemetry {
    // In-cluster OTLP/HTTP receiver of the SigNoz collector. Astra services run as
    // Compose units on signoz-net and reach the collector by its container name
    // (:4318 = the collector's OTLP/HTTP port). The host-published port (10353) is
    // NOT reachable from inside a container, so this MUST be the in-cluster address
    // for server-side spans to land. A host-run/dev process (no container) can't
    // resolve this name. Python picks between this and host-otlp-endpoint by the
    // ASTRA_RUNTIME=container marker (astra_observe); TS callers pass `{endpoint}`.
    otlp-endpoint "http://signoz-otel-collector:4318"
    // Public OTLP/HTTP endpoint the *browser* RUM posts spans to directly. The
    // server-side otlp-endpoint above is not browser-reachable in prod; this is
    // the Caddy-exposed collector (otel.iridi.cc → localhost:10353, with CORS).
    rum-endpoint "https://otel.iridi.cc"
    // The same collector as the HOST sees it (its OTLP/HTTP port published on
    // localhost). Every host-run Python process (no ASTRA_RUNTIME marker) exports here.
    host-otlp-endpoint "http://localhost:10353"
}

scribe {
    // Craig zips land in incoming-path; each session is written to {data-path}/saved/{date}.
    // incoming-path is a LOCAL dir (bind-mounted into the Dagster services). The live
    // Craig recordings live on a google-drive-ocamlfuse mount, which Docker can't
    // bind-mount (FUSE isn't in the daemon's namespace) — so zips are copied here from
    // Drive by the host `just craig-sync` timer, which reads incoming-path from here. The
    // craig_drop_sensor globs it for *.zip.
    data-path "scribe/data"
    incoming-path "scribe/incoming"
    tmp-path "scribe/tmp"
    // Transcription model — full litellm id (Decision G uses Groq Whisper, not whisperx).
    // scribe reads this and passes it to TrackTranscriber; this value is authoritative.
    model "groq/whisper-large-v3"
    groq-api-key ref="sops:groq_api_key"
}

linguist {
    // INVARIANT: must equal scribe's {data-path}/saved — the scribe→linguist handoff
    // (scribe writes saved/{date}/script.json; the linguist sensor + ingest read it).
    ingest-saved-dir "scribe/data/saved"
    // session_transcripts' non-published output, read by nothing today: the
    // campaign-matched LLM context. Bind-mounted writable into the Dagster containers.
    script-path "linguist/script"
}

mouthpiece {
    // Where the per-session asset graph writes (digest/script/clips/episode.mp3/
    // transcript.md per session), which the host publisher globs. Bind-mounted
    // into the Dagster services at the same path (deploy/docker-compose.yml). Empty would resolve to the cwd — set it so a real pipeline
    // run lands here. (NB the mouthpiece-FRONTEND audio volume is separate, D2.)
    episodes-path "mouthpiece/episodes"
    // mouthpiece's OWN model for clean/enrich + the two-pass script — GLM 5.3 via
    // OpenRouter (2026-09). Deliberately separate from llm.default-model: linguist's
    // compiled dspy judge + heartwood were tuned on GLM 5.2 and stay there.
    model "openrouter/z-ai/glm-5.3"
    // TTS backend for the episode audio: "elevenlabs" (Text-to-Dialogue, the live
    // backend) | "mock" (offline silence). The asset fails loud on a missing key —
    // never a silent fallback.
    tts-provider "elevenlabs"
    // ElevenLabs model for Text-to-Dialogue: "eleven_v4" since 2026-09-28 (was
    // "eleven_v3"; set it back here to roll back). Audio tags + IPA carry over.
    elevenlabs-model "eleven_v4"
    elevenlabs-api-key ref="sops:elevenlabs_api_key"
}

weal {
    // In-cluster addresses (Compose service DNS). The PG creds are the dev defaults
    // (match deploy/ POSTGRES_* defaults); prod overrides them at the Phase-6 cutover.
    database-url "postgres://weal:weal@weal-postgres:5432/weal"
    feed-ws-url "http://weal-overlay:10361/api/v1/roll"
    // The healthcheck endpoint (in-container only; the compose healthcheck calls it).
    bind-addr "127.0.0.1:10203"
    discord-token ref="sops:weal_discord_key"
    feed-token ref="sops:weal_token"
}

weal-overlay {
    // The port server.ts binds, in dev and in its container (host port too), and the
    // target of the Vite dev proxy. Its own port, so it never collides with strider's.
    port 10361
    token ref="sops:weal_token" // shared weal↔overlay secret
}

orator {
    guild-id "753007205510545469"
    // In-cluster Postgres (Compose service DNS); creds match deploy/ POSTGRES_*
    // defaults; prod overrides at the Phase-6 cutover. Library store (Decision F).
    database-url "postgres://orator:orator@orator-postgres:5432/orator"
    // Deploy values are the single source (config-single-source) — orator-backend
    // binds this port + origin directly; no PORT/env overrides. Behind Caddy at
    // orator.iridi.cc → host 10363.
    port 10363
    public-origin "https://orator.iridi.cc"
    // Audio + data dir = the Compose `orator-audio` volume mount (read by both the
    // service and the migrator; no ORATOR_DATA_DIR env).
    data-dir "/data"
    allowed-user-ids ""
    target-lufs -16
    ingest-concurrency 2
    measure-loudness #true
    discord-token ref="sops:orator_discord_key"
    discord-client-id ref="sops:orator_discord_client_id"
    discord-client-secret ref="sops:orator_discord_client_secret"
    session-secret ref="sops:orator_session_secret"
}

strider {
    // The SSR frontend service (Decision I) — the template for 0011-0013. Deploy
    // values are the single source (config-single-source): server.ts binds this
    // port + names telemetry with service-name; no PORT env. Behind Caddy at
    // strider.iridi.cc → host 10360. service-name also derives the browser RUM
    // service name (`{service-name}-rum`). public-origin = the absolute base URL
    // (also the canonical entry ledger links to — see the `ledger` namespace).
    service-name "astra.strider"
    port 10360
    public-origin "https://strider.iridi.cc"
}

akasha-frontend {
    // The akasha wiki read-surface (0011) — an SSR frontend on the strider
    // template (Decision I). Same config-single-source contract as strider:
    // server.ts binds this port + names telemetry; no PORT env. Behind Caddy at
    // akasha.iridi.cc → host 10365. service-name derives the browser RUM name
    // (`{service-name}-rum`). public-origin = the absolute base URL baked into
    // the build-emitted RSS/sitemap/og links (the Quartz ContentIndex contract).
    service-name "astra.akasha-frontend"
    port 10365
    public-origin "https://akasha.iridi.cc"
    // The in-container dir the session-audio volume mounts at. The SSR server serves
    // `<audio-dir>/<date>.mp3` same-origin at /audio/<date>.mp3 — the combined Craig
    // recording each transcript page plays. A runtime volume (akasha-audio, ~31 GB),
    // never baked into the image (Decision I). This replaces the surviving faerrin
    // static-audio.iridi.cc dependency; seed with `just akasha-seed`.
    audio-dir "/audio"
}

mouthpiece-frontend {
    // The podcast read-surface (0012) — an SSR frontend on the strider/akasha
    // template (Decision I). Same config-single-source contract: server.ts binds
    // this port + names telemetry; no PORT env. Behind Caddy at mouthpiece.iridi.cc
    // → host 10366. service-name derives the browser RUM name (`{service-name}-rum`).
    // public-origin = the absolute base URL baked into the build-emitted
    // /episodes.json deep-link map (the wiki/Discord contract). NB: distinct from
    // `mouthpiece` (the backend) — this is the frontend.
    service-name "astra.mouthpiece-frontend"
    port 10366
    public-origin "https://mouthpiece.iridi.cc"
    // The in-container dir the episode audio volume mounts at (D2). The SSR server
    // serves `<audio-dir>/<id>.mp3` same-origin at /audio/<id>.mp3 — the 173 MB of
    // seeded audio is a runtime volume, never baked into the image (Decision I).
    audio-dir "/audio"
}

vellum-frontend {
    // The PF2e document forge (0013) — the editor read/write surface, an SSR frontend
    // on the strider/akasha template (Decision I). Same config-single-source contract:
    // server.ts binds this port + names telemetry; no PORT env. Behind Caddy at
    // vellum.iridi.cc → host 10367. service-name derives the browser RUM name
    // (`{service-name}-rum`). public-origin = the absolute base URL (the share-link
    // origin + the host the render service is reached same-origin under). The PNG
    // export POSTs same-origin to /render, which Caddy routes to vellum-render (10368).
    service-name "astra.vellum-frontend"
    port 10367
    public-origin "https://vellum.iridi.cc"
}

vellum-render {
    // The PNG render service (0013) — a Bun.serve + Playwright sidecar (warm Chromium,
    // per-request isolated contexts, egress-blocked, semaphore-gated). Same
    // config-single-source contract: the server binds this port + names telemetry; no
    // PORT env. The editor reaches it same-origin via Caddy (vellum.iridi.cc/render →
    // host 10368). A SEPARATE Compose unit from vellum-frontend (D2).
    service-name "astra.vellum-render"
    port 10368
}

harrow {
    // The tarot deck reader (0017) — a standalone SSR frontend on the strider
    // template (Decision I), a sibling of strider (interactive, backend-less). Same
    // config-single-source contract: server.ts binds this port + names telemetry; no
    // PORT env. Behind Caddy at harrow.iridi.cc → host 10369. service-name derives
    // the browser RUM name (`{service-name}-rum`). public-origin = the absolute base
    // URL (canonical links / share origin). No backend, no DB, no audio volume — every
    // card glyph is inline SVG.
    service-name "astra.harrow"
    port 10369
    public-origin "https://harrow.iridi.cc"
}

ledger {
    // The astra landing page (0018) — a backend-less SSR frontend on the strider
    // template (Decision I), a sibling of harrow. One homepage: a gothic card grid
    // linking to the player-facing sites (strider/akasha/mouthpiece/harrow/vellum).
    // Same config-single-source contract: server.ts binds this port + names
    // telemetry; no PORT env. Behind Caddy at ledger.iridi.cc → host 10370.
    // service-name derives the browser RUM name (`{service-name}-rum`). The site
    // links it renders are NOT hardcoded — build-content reads each target site's
    // own `public-origin` from this same config (single source for every URL).
    service-name "astra.ledger"
    port 10370
}

heartwood {
    // The heartwood wiki-maintainer agent (0033) — a host-run dspy.RLM that reads one
    // faerrin session transcript and edits the akasha wiki (no review site; the 0020
    // review surface is retired). Both LMs route through astra_llm (OpenRouter); the
    // run builds two distinct LM instances even when the ids match (role = instance).
    model "openrouter/deepseek/deepseek-v4.1-flash"      // main RLM loop
    sub-model "openrouter/deepseek/deepseek-v4.1-flash"  // llm_query / llm_query_batched
    max-iterations 60      // bounds MAIN-LM calls (≤ max-iterations + 1 forced extract)
    max-llm-calls 100      // bounds SUB-LM calls only
    max-tokens 64000       // per LM call; reasoning tokens share it (GLM lesson)
    max-output-chars 10000 // REPL output shown back per iteration (dspy default)
    backfill-budget-usd 100 // cumulative backfill ceiling — stakeholder 2026-10-10 (≈2× the ~$50 estimate)
    // 0036: the Dagster session_wiki asset files <date>.request.json here and waits for the
    // host runner's <date>.result.json. Bind-mounted at the SAME path into the Dagster
    // services (deploy/docker-compose.yml) and created by `just artifacts-init`.
    requests-path "heartwood/requests"
    request-timeout-minutes 180 // how long session_wiki waits for the host before failing
    artifacts-path "heartwood" // per-run agent artifacts + the backfill lock
}

mouthpiece-producer {
    // The mouthpiece producer (0034) — a host-run, read-only dspy.RLM that briefs the
    // recap script (moments, lore, callbacks) in place of the fixed wiki excerpts +
    // continuity block. Experiment-only until the 0034 D4 runtime decision.
    model "openrouter/deepseek/deepseek-v4.1-flash"      // main RLM loop
    sub-model "openrouter/deepseek/deepseek-v4.1-flash"  // llm_query / llm_query_batched
    max-iterations 30      // bounds MAIN-LM calls
    max-llm-calls 60       // bounds SUB-LM calls only
    max-tokens 64000       // per LM call; reasoning tokens share it
    max-output-chars 10000 // REPL output shown back per iteration
    // The experiment's script arms (same order in both lists): the two-pass script runs
    // once per model with that model's per-call max_tokens. Production keeps mouthpiece.model.
    // GLM only since 2026-10-12: DeepSeek wrote choppy dialogue on 2026-10-5 (stakeholder:
    // GLM writes the scripts; DeepSeek stays the producer). Add it back to compare again.
    experiment-models "openrouter/z-ai/glm-5.3"
    experiment-max-tokens 128000
    artifacts-path "mouthpiece/experiments" // per-run producer/roundtable artifacts
}

portal {
    // portal (0023) — a TypeScript MCP+WS server for the live FoundryVTT "Faerrin"
    // campaign world, on the orator-backend template (D3: no build step, no browser
    // RUM surface, so — unlike the SSR frontends — there's no service-name field
    // here; astra.portal is hardcoded in server/src/index.ts, mirroring orator).
    // Same config-single-source contract otherwise: the server binds this port; no
    // PORT env. Behind Caddy at portal.iridi.cc → host 10372 (S6).
    port 10372
    public-origin "https://portal.iridi.cc"
    // Two-hop auth (D6): mcp-api-key bearer-gates the Streamable-HTTP /mcp surface
    // (MCP client -> server); bridge-api-key gates the Foundry module's WS
    // handshake (module -> server). bridge-timeout-ms bounds a stalled
    // module round-trip (typed "timeout" error, never a hang — the liveness
    // constraint). max-creates-per-request is the D8 write-gate cap.
    bridge-timeout-ms 15000
    max-creates-per-request 10
    // The one Foundry user allowed to hold the bridge socket: the dedicated "Portal"
    // GM account that portal-headless logs in. Any other GM session's dial is refused
    // (close code 4003). "" = no designation: the first user keeps the bridge.
    bridge-user-id "xlC6LfQ7godJVVFf"
    mcp-api-key ref="sops:portal_mcp_api_key"
    // 0028 D28-1 — the player-facing static key: a second bearer compared alongside
    // mcp-api-key in the /mcp auth branch, resolving to the read-only D28-8 tool
    // subset instead of the admin scope. Same load-bearing contract as mcp-api-key
    // (requireSecret, no degraded mode). Value minted at S4 (stakeholder-gated).
    player-mcp-api-key ref="sops:portal_player_api_key"
    bridge-api-key ref="sops:portal_bridge_api_key"
    // 0025 OAuth state file (registered clients + hashed tokens) — on the
    // portal-oauth bind mount, so a claude.ai connection survives `just up`.
    oauth-state-path "/data/oauth/state.json"
}

portal-headless {
    // portal-headless (0027 D27-5/-13) — a supervised headless-Chromium GM session, a
    // dedicated Foundry account ("Portal", full GM) permanently logged into the live
    // pf2e "Faerrin" world through the public edge, so portal's MCP tools work with no
    // human browser tab open (spec 0027). A SEPARATE Compose unit from portal-server:
    // health-only, not edge-routed (no Caddy entry).
    port 10373
    // D27-3: the public edge — the exact path a human browser takes.
    foundry-origin "https://btl.iridi.cc"
    world "faerrin"
    gm-username "Portal"
    // D27-4/-14: the dedicated account's password, resolved only at login time —
    // never logged. Set at S4 with the stakeholder.
    gm-password ref="sops:foundry_portal_gm_password"
    // D27-10: periodic page reload while healthy (slow-leak insurance); 0 disables.
    reload-interval-hours 24
}

codex {
    // The PF2e reference site (0029) — a public-but-noindexed build-time ingest +
    // SSR frontend on the strider template (Decision I). Same config-single-source
    // contract: the server binds this port; no PORT env. Behind Caddy at
    // codex.iridi.cc → host 10374. data-path is the corpus dir the ingest
    // pipeline (`just codex-refresh`) writes to, under data.root. P2 S3 (D29-30) wired client RUM (src/observe/{rum,
    // rumConfig}.ts, startRum in __root's mount effect) — it reads the top-level
    // telemetry.rum-endpoint (above).
    service-name "astra.codex"
    port 10374
    data-path "codex/data"
}

menhir {
    // menhir (0031) — a Kahoot-style session-opener quiz, on the weal-overlay
    // template (srvx server + SSE fan-out + vite React SPA, no auth per R4). Same
    // config-single-source contract: server.ts binds this port + names telemetry;
    // no PORT env. Behind Caddy at menhir.iridi.cc → host 10375. results-path is the
    // JSONL append target (identical-path bind mount, D29-53 convention — plain config
    // fields have no env override).
    service-name "astra.menhir"
    port 10375
    public-origin "https://menhir.iridi.cc"
    results-path "menhir/results.jsonl"
}
