[Unit]
Description=Auto-commit + push new linguist transcripts/data (pipeline source-of-record) for astra
Documentation=https://github.com/jbassin/astra
# Class C alerting: page Discord directly on failure (e.g. a push that keeps failing). The
# handler decrypts the webhook from SOPS at runtime. %n = linguist-commit.service.
OnFailure=astra-alert@%n.service

[Service]
Type=oneshot
# Runs the recipe from the deploy checkout, with the venv deploy.sh keeps in
# sync there; every path it touches comes from config.kdl, under the data root
# /ruby/data/astra-state, never this checkout.
WorkingDirectory=/ruby/data/astra-deploy
# `just` lives in the user's cargo bin. The recipe commits the linguist datasets the Dagster
# run workers write into the astra-data clone (via bind mounts), refreshes the mouthpiece
# snapshot, pushes the clone and redeploys the frontends. Runs as the user (not in a
# container) so it has git, the git identity and the SSH push key; the Dagster containers
# have none of those. The recipe is LIVE, so it asks first: --yes answers for this
# unattended unit (without it, no terminal means exit 64). After a deploy that changes this
# line, re-run `just units-install linguist-commit` (daemon-reload) or systemd keeps the old one.
ExecStart=/home/jbassin/.cargo/bin/just linguist-commit --yes
# A oneshot has no start timeout by default, and the watchdog treats a timer whose service is
# still activating as healthy, so a wedged run would look green forever. Runs
# take 3 s typically, 59 s at most (journal, 2026-10-15 to 10-24), but the worst legitimate
# run waits up to 30 min for the git-publish lock (a heartwood run holds it), up to 30 min
# for the deploy lock, then builds and health-checks a frontend (about 10 min). 90 min covers
# that; past it systemd kills the run and OnFailure pages.
TimeoutStartSec=90min
