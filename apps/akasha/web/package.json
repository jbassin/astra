{
  "name": "@astra/akasha-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner && tsdown --config-loader tsx && node --import tsx scripts/build-search.ts",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "node --import tsx scripts/build-content.ts && tsc --noEmit",
    "test": "vitest run",
    "generate:content": "node --import tsx scripts/build-content.ts"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/content-build": "workspace:*",
    "@astra/gothic": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/ontology": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@astra/vellum-lang": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tweenjs/tween.js": "^25.0.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "github-slugger": "^2.0.0",
    "pixi.js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "gray-matter": "catalog:",
    "jsdom": "catalog:",
    "pagefind": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "akasha-frontend"
  }
}
