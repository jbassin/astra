{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/being.canonical.json",
      "!**/akasha-snapshot.json",
      "!**/fixtures/vellum/**",
      "!**/tests/fixtures/**",
      "!**/linguist/data/**",
      "!**/routeTree.gen.ts",
      "!**/src/generated/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "useBiomeIgnoreFolder": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["**/vellum-lang/src/vss.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off", "useTemplate": "off" } } }
    },
    {
      "includes": ["**/gothic/src/render/**"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      "includes": [
        "**/strider/src/lib/hexUtils.ts",
        "**/strider/src/lib/hexUtils.test.ts",
        "**/strider/src/lib/layers.test.ts"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
