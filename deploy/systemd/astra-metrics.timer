[Unit]
Description=Write the astra host metrics every 2 minutes

[Timer]
# Wall-clock every 2 minutes, like the other astra timers (a valid next trigger no matter
# when enabled). The rules' windows assume this cadence: unhealthy for 10 min is about 5
# samples; the textfile counts as stale after 10 min.
OnCalendar=*:0/2
Persistent=true

[Install]
WantedBy=timers.target
