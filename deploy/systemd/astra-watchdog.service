[Unit]
Description=astra liveness watchdog — Drive FUSE mount responsive + pipeline timers armed (Class B)
Documentation=https://github.com/jbassin/astra
# If the watchdog itself errors, page (it can't detect its own death, but it can its own
# failure). The handler's failure path is independent of the watchdog logic, so no loop.
# (OnFailure is a [Unit] key — systemd silently ignores it under [Service].)
OnFailure=astra-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/ruby/data/astra-deploy
# Probes the Drive FUSE front door (bounded — never wedges) and checks craig-sync.timer +
# linguist-commit.timer are active AND armed; debounced so it pages only on state changes.
# A bad reading is re-confirmed over a short window before paging (the watchdog runs on the
# same wall-clock ticks the watched timers fire on, so a single sample flaps). A confirmed
# wedged mount is auto-remediated (abort FUSE conn + lazy unmount + wait for gdrive.service
# to remount + re-probe) — worst case ~90s confirm + ~80s remediation. It also checks backup
# snapshot age, restore-test age and entity.kdl drift (the seed check waits up to 30s for a
# lock and runs up to 60s), so the timeout still leaves margin.
ExecStart=/ruby/data/astra-deploy/deploy/systemd/alert-notify.sh watchdog
TimeoutStartSec=480
