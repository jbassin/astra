// Production SSR entry for the __name__ Compose service: site-kit's createSsrServer serves the
// built client assets and the SSR handler. Service name and port come from config.kdl.
// `pnpm run build` bundles this file into `dist-server/main.mjs` (tsdown.config.ts), and the
// image runs that bundle. Run after `pnpm run build`: pnpm run start

import path from "node:path";

import { findPackageRoot, loadConfig } from "@astra/config";
import { createSsrServer, loadSsrBuild } from "@astra/site-kit";

const APP = findPackageRoot(import.meta.dirname);
const { serviceName, port } = loadConfig().__camel__;

createSsrServer({
  serviceName,
  port,
  ssr: await loadSsrBuild(APP),
  clientDir: path.join(APP, "dist", "client"),
});
