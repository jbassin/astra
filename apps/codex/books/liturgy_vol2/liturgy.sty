% ---------------------------------------------------------------- page furniture
% Parchment: KjUQoJD.jpg is a two-page spread -- pre-cropped odd(left)/even(right)
% halves at asset-prep time (more robust than in-TeX viewport arithmetic).
\newcommand{\liturgyparchment}{%
  \ifodd\value{page}
    \AtPageLowerLeft{\includegraphics[width=\paperwidth,height=\paperheight]{assets/img/parchment-left.jpg}}%
  \else
    \AtPageLowerLeft{\includegraphics[width=\paperwidth,height=\paperheight]{assets/img/parchment-right.jpg}}%
  \fi
}
\AddToShipoutPictureBG{\liturgyparchment}

% footer: page number (outer, dark red OPTIPegasus, nested in the ornament's
% outer curl) + footnote label (inner, Wolpe Pegasus small caps, unchanged)
% + a FULL-WIDTH footer accent line (vol1/PHB pattern: width:100%, mirrored
% via scaleX(-1) on alternating pages so the decorative curl always lands on
% the OUTER edge -- right on odd/recto, left on even/verso).
% Default before chapter 1's own \renewcommand fires (book.py) — front
% matter (cover/credits/Reading This Book/How to Read a Spell Block/
% Contents) renders under THIS default, so it must not be a chapter label
% (was literally "Chapter 1 | Antillurgy", leaking a wrong chapter title
% onto 5 pre-chapter pages — S3 live-render catch).
\newcommand{\liturgyfootnotelabel}{Liturgy of the Iridite \textbar\ Volume II}
\newcommand{\liturgyfooterart}{%
  \ifodd\value{page}
    \includegraphics[width=\paperwidth]{assets/img/vLDUmXL.png}%
  \else
    \reflectbox{\includegraphics[width=\paperwidth]{assets/img/vLDUmXL.png}}%
  \fi
}
% One-shot furniture suppression: over full-bleed cover art the footer
% line/label/page-number are visual noise (vol1 covers carry no furniture).
% book.py sets this on the art-backed cover page; the shipout hook consumes
% and clears it so every later page renders furniture normally.
\newif\ifliturgysuppressfurniture
\newcommand{\liturgyfurniture}{%
  \ifliturgysuppressfurniture
    \global\liturgysuppressfurniturefalse
  \else
  \liturgyfurnituredraw
  \fi}
\newcommand{\liturgyfurnituredraw}{%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[opacity=0.6]
      \node[anchor=south west, inner sep=0pt] at (current page.south west)
        {\liturgyfooterart};
    \end{scope}
    % Page-number x/y offsets are tuned to nest the digit in the footer
    % ornament's open hook pocket (the wedge between the curl stroke and the
    % rule it springs from), clear of every stroke. The curl departs the
    % rule ~1.3cm from the outer edge, which is exactly where the digit used
    % to collide with it -- pulling the anchor in to ~0.7cm from the edge
    % lands the digit inside the pocket instead. Symmetric across parities
    % (the art is reflectbox-mirrored on even pages, so one offset pair
    % serves both -- verified against rendered odd/even proofs).
    \ifodd\value{page}
      \node[anchor=south east, xshift=-0.76cm, yshift=0.66cm] at (current page.south east)
        {\optipegasus\fontsize{12pt}{12pt}\selectfont\color{DarkRed}\thepage};
      \node[anchor=south west, xshift=1.9cm, yshift=0.6cm] at (current page.south west)
        {\wolpe\fontsize{0.37cm}{0.45cm}\selectfont\color{DarkRed}\liturgyfootnotelabel};
    \else
      \node[anchor=south west, xshift=0.76cm, yshift=0.66cm] at (current page.south west)
        {\optipegasus\fontsize{12pt}{12pt}\selectfont\color{DarkRed}\thepage};
      \node[anchor=south east, xshift=-1.9cm, yshift=0.6cm] at (current page.south east)
        {\wolpe\fontsize{0.37cm}{0.45cm}\selectfont\color{DarkRed}\liturgyfootnotelabel};
    \fi
  \end{tikzpicture}%
}
\AddToShipoutPictureFG{\liturgyfurniture}
\pagestyle{empty}

% ---------------------------------------------------------------- chapter opener
% Wolpe Pegasus small-caps title; gradient fill approximated as solid ChapterTitle.
\newcommand{\chapternum}[1]{{\mreaves\fontsize{0.74cm}{0.85cm}\selectfont\color{DarkRed}\MakeUppercase{#1}\par}}
\newcommand{\chaptertitle}[1]{{\wolpe\fontsize{1.4cm}{1.5cm}\selectfont\color{ChapterTitle}\MakeUppercase{#1}\par}}
\newcommand{\chapterrule}{\vspace{-2pt}\includegraphics[width=\textwidth]{assets/img/w1Yiycy.png}\vspace{4pt}}

% Chapter openers reserve their RIGHT column for the future ART SLOT image
% (ART-SLOTS.md) instead of flowing opener prose through both multicols
% columns -- the vol1 Homebrewery original kept opener prose to ONE column
% and let a chapterSidebarRight image occupy the other. multicols cannot be
% used for this: its column-balancing pass overrides a mid-flow
% \columnbreak whenever the preceding content exceeds one column's height
% (verified with a minimal tectonic reproduction -- text spilled across
% BOTH columns and the forced break landed on a phantom extra page instead;
% a documented multicol limitation, not a mistuning). A single narrowed
% text measure via adjustwidth paginates normally instead.
%
% \openerreserve started at the vol1 mask ratio (332/794 =~ 0.42\textwidth)
% but 3 of the 8 openers (chronomancy/gestalt/memetics -- the longest,
% 5-paragraph fragments) overflowed a SECOND page at that width even with
% nothing shortened, which then rendered the reservation TWICE (once on the
% opener page, once on the spillover spell-list page -- worse than the
% original defect). A SEPARATE bug (below, \liturgynote's dropped
% \needspace) was masking the true fit at first; once that was fixed, the
% width still had to come down to 0.30\textwidth (+ a slightly tighter
% opener \parskip, still well short of \spellflow's dense 0.15cm) before
% the longest fragment (planara, 4 dense paragraphs + a 6-row glossary
% note) cleared one page with room to spare.
%
% Design-fix round (stakeholder: art read as an undersized floating strip,
% no gold frame): re-tried WIDER at 0.34\textwidth once the art started
% actually FILLING its window (see \openerartimage below) instead of
% floating top-aligned at natural aspect -- planara (still the tightest
% fragment) overflowed to a SECOND page at 0.34 (chapter 7 grew 53-60 ->
% 53-61, the whole book 62 -> 63pp), so per the fallback rule this stayed
% at 0.30\textwidth rather than shipping a book-length regression.
%
% S5 NO-CROP round (stakeholder: "we can substantially cut down on the
% prose ... I'd rather get the full art" -- explicit authorization to trim
% opener prose in exchange for showing the art UNCROPPED): the delivered
% art is a tall, narrow ~610x1650px slice (ratio ~0.370, verified against
% every processed/<school>.png) and the old 0.30\textwidth reserve cropped
% roughly a third of its width away under cover-fit. \openerartratio is
% that measured minimum width/height ratio across the 8 processed images
% (mercuromancy's 585x1581 is the tightest at exactly 0.3700; the others
% run 0.3701-0.3708) -- using the MINIMUM means \openerwindowwidth (below)
% is always <= every image's natural width at the fixed window height, so
% the \clip in \openerartimage removes at most a hairline sliver (<0.3%)
% on the few images slightly above the minimum ratio and NOTHING on
% mercuromancy -- never a letterboxing gap. \openerreserve is now DERIVED
% from the window (not the other way around, S1-S4's direction): the
% window height is fixed page geometry, so ratio*height fixes the window
% width, and reserve is just that plus the 0.5cm prose gutter.
\newcommand{\openerartratio}{0.370}
\newlength{\openerreserve}
% ---- opener art window geometry (shared by the placeholder + the real
% art + the frame) -----------------------------------------------------
% Vertical bounds are FIXED regardless of \openerreserve -- only the width
% (below) tracks the reserved column. Same -5.0cm/+2.3cm bounds the
% placeholder always used, now named so all three consumers agree.
\newlength{\openerwindowtop}
\setlength{\openerwindowtop}{5.0cm}
\newlength{\openerwindowbottom}
\setlength{\openerwindowbottom}{2.3cm}
\newlength{\openerwindowheight}
\setlength{\openerwindowheight}{\dimexpr\paperheight-\openerwindowtop-\openerwindowbottom\relax}
% width = the no-crop target ratio times the (fixed) window height --
% see the S5 comment above. \openerreserve then adds back the 0.5cm prose
% gutter that keeps the art clear of the narrowed text column.
\newlength{\openerwindowwidth}
\setlength{\openerwindowwidth}{\openerartratio\openerwindowheight}
\setlength{\openerreserve}{\dimexpr\openerwindowwidth+0.5cm\relax}
% S5 no-crop round narrowed the opener measure from ~12.45cm to ~9.65cm
% (0.70\textwidth -> ~0.54\textwidth), which pushed a handful of lines --
% mostly ones ending in a long unhyphenated compound like "timestream" --
% into a badly Overfull \hbox (up to ~24pt, visibly clipped text touching
% the art frame; confirmed against a live render, not just the log
% warning). \tolerance/\emergencystretch give the line breaker a last-
% resort escape valve (extra interword stretch) before it accepts an
% overfull line, at the cost of very slightly looser spacing on the rare
% line that needs it -- default \tolerance (200) is right for the WIDE
% chapter body (spellflow columns), too strict for this narrow measure.
\newenvironment{openerbody}{%
  \begin{adjustwidth}{0pt}{\openerreserve}%
  \setlength{\parskip}{0.18cm}%
  \tolerance=2000
  \emergencystretch=2em
}{%
  \end{adjustwidth}%
}
% Sets up (owNW)/(owNE)/(owSW)/(owSE) page-absolute tikz coordinates for
% the reserved window's four corners; right edge at the text margin.
\newcommand{\openersetupwindow}{%
  \coordinate (owNE) at ($(current page.north east) + (-1.9cm, -\openerwindowtop)$);
  \coordinate (owSE) at ($(current page.south east) + (-1.9cm, \openerwindowbottom)$);
  \coordinate (owNW) at ($(owNE) + (-\openerwindowwidth, 0pt)$);
  \coordinate (owSW) at ($(owSE) + (-\openerwindowwidth, 0pt)$);
}

% ---- gold frame (vol1 parity: assets/img/frame-gold.png, the ORIGINAL
% https://i.imgur.com/10FwDJM.png Homebrewery border-image source) -----
% A true 9-patch: 4 fixed-scale ornamental corners + 4 stretched edge
% bands, sliced straight out of the 562x562 source via \includegraphics
% trim+clip (bp==px here -- the PNG carries no dpi chunk, so tectonic's
% default 72dpi treatment makes 1px==1bp, verified against a live render).
% border-image-slice:270 on a 562px image -> corner blocks are 270px,
% leaving a 22px middle strip (562-270-270) that supplies the edge bands'
% cross-section, stretched along the run between corners.
%
% Sizes are tuned against the ACTUAL vol1 PDF render, not the Homebrewery
% CSS text: the CSS claims border-image-width:24mm, but measuring the
% live vol1 export (pdftoppm at 400dpi, same letter page size we use)
% shows the frame band is really ~3mm wide on the page -- the export
% pipeline never honored the CSS mm value literally. \openerframeband
% below matches that measured absolute width; \openerframecorner is a
% touch larger than a pure width-ratio scale-down (vol1's ~8.8cm window
% carried a ~9.5mm corner) so the chamfer still reads as ornamental at
% our narrower ~5cm column instead of shrinking to an illegible nub.
\newlength{\openerframecorner}
\setlength{\openerframecorner}{7mm}
\newlength{\openerframeband}
\setlength{\openerframeband}{3mm}
% Frame straddles the window boundary (vol1: the frame extends ~3.8mm
% outside its mask, and the art tucks under the frame's inner lip) --
% split evenly: half bleeds past the window into the margin/gutter, half
% overlaps inward and covers the art's outer rim.
\newlength{\openerframebleed}
\setlength{\openerframebleed}{1.5mm}
% S5 corner-mask round (stakeholder: art corners poked past the frame's
% corner ornaments): the corner tile (assets/img/frame-gold.png, 292x292bp
% slice) is mostly TRANSPARENT except a thin gold L-bracket hugging the
% outer edge with a rounded/chamfered inner joint (verified visually) --
% by design the box's own fill shows through that transparent interior
% (ordinary border-image behavior), but the ART's hard RECTANGULAR corner
% was extending all the way into that transparent area, so its sharp
% square edge stuck out past the bracket's curved joint instead of
% terminating at (or behind) it. Vol1's own export does the same thing
% Homebrewery's CSS can't: it clips the ARTWORK to a chamfered (45°-cut)
% rectangle so the art's corner recedes with the bracket instead of
% fighting it. \openerartchamfer was calibrated empirically against a
% standalone 400dpi render (a fast \openerartimage-only test doc, swept
% 1.0/1.3/1.6/3.0mm and diffed the corner crop pixel-for-pixel): 3mm
% overshot badly (a wide bare-parchment wedge between the bracket and the
% art's cut edge -- the naive "corner tile is 7mm, cut ~15-20% of that"
% math above OVERSTATES the bracket's real reach, since most of the 7mm
% tile's tail is the bleed-out margin and stretched edge-strip overlap,
% not corner-local coverage); 1.2mm tucks the art's cut edge under the
% bracket's curve with only a hairline of parchment at the very tip --
% matching vol1's own reference look rather than a seamless (impossible
% without redrawing frame-gold.png) mask.
\newlength{\openerartchamfer}
\setlength{\openerartchamfer}{1.2mm}
\newcommand{\openerartclip}{%
  \clip ($(owNW)+(0,-\openerartchamfer)$) -- ($(owNW)+(\openerartchamfer,0)$)
        -- ($(owNE)+(-\openerartchamfer,0)$) -- ($(owNE)+(0,-\openerartchamfer)$)
        -- ($(owSE)+(0,\openerartchamfer)$) -- ($(owSE)+(-\openerartchamfer,0)$)
        -- ($(owSW)+(\openerartchamfer,0)$) -- ($(owSW)+(0,\openerartchamfer)$)
        -- cycle;
}
\newcommand{\openerdrawframe}{%
  \coordinate (ofNW) at ($(owNW) + (-\openerframebleed, \openerframebleed)$);
  \coordinate (ofNE) at ($(owNE) + (\openerframebleed, \openerframebleed)$);
  \coordinate (ofSW) at ($(owSW) + (-\openerframebleed, -\openerframebleed)$);
  \coordinate (ofSE) at ($(owSE) + (\openerframebleed, -\openerframebleed)$);
  % corners -- trim=(left,bottom,right,top) in bp against the 562x562
  % source (slice=270, mid-strip boundary=292 == 562-270)
  \node[anchor=north west, inner sep=0pt] at (ofNW)
    {\includegraphics[trim=0bp 292bp 292bp 0bp,clip,
      width=\openerframecorner,height=\openerframecorner]{assets/img/frame-gold.png}};
  \node[anchor=north east, inner sep=0pt] at (ofNE)
    {\includegraphics[trim=292bp 292bp 0bp 0bp,clip,
      width=\openerframecorner,height=\openerframecorner]{assets/img/frame-gold.png}};
  \node[anchor=south west, inner sep=0pt] at (ofSW)
    {\includegraphics[trim=0bp 0bp 292bp 292bp,clip,
      width=\openerframecorner,height=\openerframecorner]{assets/img/frame-gold.png}};
  \node[anchor=south east, inner sep=0pt] at (ofSE)
    {\includegraphics[trim=292bp 0bp 0bp 292bp,clip,
      width=\openerframecorner,height=\openerframecorner]{assets/img/frame-gold.png}};
  % edges -- stretched to span between the corners along each run
  \pgfmathsetlengthmacro{\openeredgeh}{\openerwindowwidth+2\openerframebleed-2\openerframecorner}
  \pgfmathsetlengthmacro{\openeredgev}{\openerwindowheight+2\openerframebleed-2\openerframecorner}
  \node[anchor=north, inner sep=0pt] at ($(ofNW)!0.5!(ofNE)$)
    {\includegraphics[trim=270bp 292bp 270bp 0bp,clip,
      width=\openeredgeh,height=\openerframeband]{assets/img/frame-gold.png}};
  \node[anchor=south, inner sep=0pt] at ($(ofSW)!0.5!(ofSE)$)
    {\includegraphics[trim=270bp 0bp 270bp 292bp,clip,
      width=\openeredgeh,height=\openerframeband]{assets/img/frame-gold.png}};
  \node[anchor=west, inner sep=0pt] at ($(ofNW)!0.5!(ofSW)$)
    {\includegraphics[trim=0bp 270bp 292bp 270bp,clip,
      width=\openerframeband,height=\openeredgev]{assets/img/frame-gold.png}};
  \node[anchor=east, inner sep=0pt] at ($(ofNE)!0.5!(ofSE)$)
    {\includegraphics[trim=292bp 270bp 0bp 270bp,clip,
      width=\openerframeband,height=\openeredgev]{assets/img/frame-gold.png}};
}

% Placeholder frame for the reserved column, drawn independently of text
% flow via a page-absolute tikz overlay (so it can never collide with the
% adjustwidth'd prose). Purely a review aid -- it marks the reservation as
% deliberate rather than a rendering bug -- and is meant to be deleted the
% moment real art lands in ART-SLOTS.md. Previews the SAME window bounds
% \openerartimage fills, via the shared \openersetupwindow coordinates.
\newcommand{\openerartslot}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \openersetupwindow
    \draw[Gold, dashed, rounded corners=3mm] (owNW) rectangle (owSE);
    \node[align=center, text width=0.8\openerwindowwidth, font=\itshape\small,
          color=DarkRed!70]
      at ($(owNW)!0.5!(owSE)$)
      {Art placeholder\\[3pt]\texttt{\footnotesize#1}\\[6pt]see ART-SLOTS.md};
  \end{tikzpicture}%
}
% Real stakeholder art for a chapter opener, once dropped into
% assets/img/processed/<school>.(png|jpg) (book.py's fail-soft lookup swaps
% \openerartslot for this the moment the file exists). Vol1-style FRAMED
% WINDOW: the art fills the reserved column's full height at its OWN
% native aspect (\openerwindowwidth is derived from \openerartratio, S5
% round, so this is a no-crop fit, not cover-fit center-cropping) with no
% distortion and no letterboxing; the tikz \clip is chamfered
% (\openerartclip, S5 corner-mask round) rather than a plain rectangle so
% the art's own corner recedes under the frame's bracket instead of
% poking past it; a true gold 9-patch frame (\openerdrawframe) is drawn on
% top, straddling the window edge the same way vol1's border-image does.
\newcommand{\openerartimage}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \openersetupwindow
    \begin{scope}
      \openerartclip
      \node[anchor=center, inner sep=0pt] at ($(owNW)!0.5!(owSE)$)
        {\includegraphics[height=\openerwindowheight]{#1}};
    \end{scope}
    \openerdrawframe
  \end{tikzpicture}%
}

% drop cap: lettrine + Wolpe Pegasus; the CSS target layers a gradient fill
% behind a symbol image (6tnz3j7.png) -- approximated here as a flat
% DropGold-colored letter, symbol-behind not composited.
\newcommand{\liturgydropcap}[2]{%
  \lettrine[lines=3,loversize=0.1,lraise=0.05,nindent=0pt]%
    {\wolpe\color{DropGold}#1}{#2}}

% ---------------------------------------------------------------- trait pills
% Approximation: single gold frame (design target = 2px DOUBLE gold border).
% Sized ~0.95em of the 9.6pt body (~8pt) with tight padding so the row reads
% compact, matching the vol1/PHB reference rather than the earlier oversized pass.
\newcommand{\pill}[1]{\tcbox[colback=DarkRed,colframe=PillGold,boxrule=1.1pt,
  arc=0pt,left=1.5pt,right=1.5pt,top=1pt,bottom=1pt,on line,
  fontupper=\scalycaps\fontsize{8pt}{8.5pt}\selectfont\color{white}]{\MakeUppercase{#1}}}

\RequirePackage{xstring}
\newcommand{\rpillbox}[2]{\tcbox[colback=#1,colframe=PillGold,boxrule=1.1pt,
  arc=0pt,left=1.5pt,right=1.5pt,top=1pt,bottom=1pt,on line,
  fontupper=\scalycaps\fontsize{8pt}{8.5pt}\selectfont\color{white}]{\MakeUppercase{#2}}}
\newcommand{\raritypill}[1]{%
  \IfStrEq{#1}{uncommon}{\rpillbox{RarityUncommon}{#1}}{%
  \IfStrEq{#1}{rare}{\rpillbox{RarityRare}{#1}}{%
  \IfStrEq{#1}{unique}{\rpillbox{RarityUnique}{#1}}{\rpillbox{DarkRed}{#1}}}}}
% school pill: the 8 school traits (antillurgy, chronomancy, gestalt,
% kosmoturgy, memetics, mercuromancy, planara, seraphic) render in the same
% purple used for 'unique' rarity, not the default dark-red pill background.
% Pill row order (stakeholder rule): rarity pill (if any) -> school pill ->
% remaining traits alphabetical.
\newcommand{\schoolpill}[1]{\rpillbox{RarityUnique}{#1}}

% ---------------------------------------------------------------- spell block plumbing
% preamble title line: Name (+ optional action glyph) ... right-aligned Kind
% Built as one \hbox (not fill-glue inside a \par'd paragraph) so the line
% never wraps/re-breaks, then the rule is a SEPARATE hrule dropped just below
% the text baseline (nointerlineskip + a small clearance) -- previously the
% negative \vspace{-3pt} after \par pulled the rule up onto the text itself,
% striking through the title/kind glyphs. Trailing space trimmed to 2pt so
% the (now-smaller) trait-pill row hugs the rule instead of floating below it.
\newcommand{\spelltitle}[3]{%
  \hbox to \linewidth{%
    \scalycapsbold\fontsize{0.46cm}{0.5cm}\selectfont\color{black}#1%
    \IfStrEq{#2}{}{}{\ {\actionfont\fontsize{0.46cm}{0.5cm}\selectfont#2}}%
    \hfil
    \scalycapsbold\fontsize{0.4cm}{0.45cm}\selectfont\MakeUppercase{#3}}\par
  \nointerlineskip\vspace{1.5pt}\hrule height 0.4pt\vspace{2pt}%
}
% Keep the preamble+pills+first def-rows together as one atomic block so it
% never splits mid-title across a column break. NOTE: needspace was tried
% first (per the design brief) but is documented as unreliable inside
% multicols -- it measures against \pagegoal/\pagetotal (whole-page), not
% the current column, and produced enormous spurious blank gaps at the
% bottom of columns. A minipage is sized/measured correctly per-column, so
% it is used here instead: the header only ever moves whole to the next
% column, never leaving a large gap behind.
\newenvironment{blockhead}{\begin{minipage}{\linewidth}}{\end{minipage}\par}

% a definition row: bold label, plain value
\newcommand{\defrow}[2]{\textbf{#1} #2\\}
% rule between block sections
\newcommand{\blockrule}{\par\vspace{2pt}\hrule height 0.8pt\vspace{4pt}}
\newcommand{\thinrule}{\par\vspace{3pt}\hrule height 0.5pt\vspace{3pt}}
% heightened postamble entry
\newcommand{\heightened}[2]{\textbf{Heightened (#1)} #2\par}

% body hr: a low-opacity decorative texture strip
\newcommand{\bodyhr}{\par\vspace{3pt}{\begin{tikzpicture}\begin{scope}[opacity=0.45]
  \node[inner sep=0pt]{\includegraphics[width=\linewidth,height=2.5mm]{assets/img/RhYXAkP.png}};
  \end{scope}\end{tikzpicture}}\vspace{3pt}\par}

% ---------------------------------------------------------------- note box
% needspace DROPPED (S3 live-render catch): it measures against
% \pagegoal/\pagetotal (whole-page, per the \blockhead note above) and, once
% enough content follows LATER in the document, was observed to fire a
% spurious break that silently discarded the openerbody narrowing on the
% CURRENT page (reproduced in isolation -- removing this one line fixed it).
% tcolorbox's own (non-breakable by default) box already keeps the note
% intact as a unit; no manual keep-together guard is worth needspace's risk.
\newcommand{\liturgynote}[1]{%
  \begin{tcolorbox}[colback=NoteBg,colframe=DarkRed,boxrule=0.8pt,arc=1mm,
    left=2mm,right=2mm,top=1.5mm,bottom=1.5mm]
    {\scaly\fontsize{9pt}{11pt}\selectfont #1}
  \end{tcolorbox}%
}

% ---------------------------------------------------------------- tables
% plain-rule (booktabs-free) striped table helper colors set at call site
\newcommand{\tblhead}[1]{\scalycapsbold\fontsize{9pt}{11pt}\selectfont\color{DarkRed}#1}

% In-block random-effect tables (e.g. Eye Stalks' d8 Ray/Effect table) are
% NOT emitted as one multi-row tabularx -- a plain tabularx has no internal
% page/column-break points, so a table taller than one column either
% overflows the text block into the footer or silently drops whatever falls
% past the page edge (confirmed against a pre-fix render: rows 7-8 of the
% Eye Stalks table never made it onto page 28 at all). Instead book.py calls
% \tblrow once per physical table-row (header+first-row paired together, see
% book.py's ``_render_table_latex``), each its own tabularx built from the
% SAME colspec -- so the rows stay pixel-aligned -- separated by an ordinary
% blank-line paragraph break, which tectonic is free to break a column/page
% at exactly like it already does between any two flowing blocks. #1 =
% colspec (identical across every call for one table), #2 = the row's body
% (whatever mix of \hline/\rowcolor/cells the caller needs).
\newcommand{\tblrow}[2]{%
  \noindent
  \begin{tabularx}{\linewidth}{#1}
  #2
  \end{tabularx}%
}

% ---------------------------------------------------------------- inline action glyph
% for an action-glyph appearing IN BODY TEXT (e.g. "you may Stride as a free
% action {glyph}"), as opposed to the title-line glyph \spelltitle sets
% directly. Same Pathfinder2eActions font, just a plain inline call.
\newcommand{\actglyph}[1]{{\actionfont #1}}

% ---------------------------------------------------------------- front matter + toc
% Added for the vol2 LaTeX cutover (S2) -- front matter/ToC were never part
% of the S1-reviewed sample, so these are NEW macros, not a restyle of
% anything the stakeholder signed off. They deliberately reuse the already-
% approved display faces (Wolpe Pegasus, Mr Eaves Small Caps) rather than
% introducing new fonts.
% Art-mode cover text: over real cover art the dark-red text is illegible
% (live catch on the first fm-cover drop) -- vol1's cover idiom is light
% text with a dark poster shadow. book.py sets \liturgycoverarttrue on the
% cover page ONLY when fm-cover art was actually placed; the three cover
% macros then render cream with a shadow (two offset tikz nodes -- the
% contour package isn't a bundle certainty, layered nodes are).
\newif\ifliturgycoverart
\definecolor{CoverCream}{HTML}{EEE5CE}
\newcommand{\livshadowline}[1]{%
  \begin{tikzpicture}[baseline]
    \node[align=center, text width=0.92\textwidth, inner sep=0pt,
          text=black, opacity=0.8] at (0.05cm,-0.05cm) {#1};
    \node[align=center, text width=0.92\textwidth, inner sep=0pt,
          text=CoverCream] at (0cm,0cm) {#1};
  \end{tikzpicture}\par}
\newcommand{\covereyebrow}[1]{%
  \ifliturgycoverart
    {\wolpe\fontsize{0.42cm}{0.5cm}\selectfont\livshadowline{\MakeUppercase{#1}}}%
  \else
    {\wolpe\fontsize{0.42cm}{0.5cm}\selectfont\color{DarkRed}\MakeUppercase{#1}\par}%
  \fi}
\newcommand{\covertitle}[1]{%
  \ifliturgycoverart
    {\wolpe\fontsize{2.1cm}{2.3cm}\selectfont\livshadowline{\MakeUppercase{#1}}}%
  \else
    {\wolpe\fontsize{2.1cm}{2.3cm}\selectfont\color{ChapterTitle}\MakeUppercase{#1}\par}%
  \fi}
\newcommand{\coversubtitle}[1]{%
  \ifliturgycoverart
    {\mreaves\fontsize{0.85cm}{1.0cm}\selectfont\livshadowline{#1}}%
  \else
    {\mreaves\fontsize{0.85cm}{1.0cm}\selectfont\color{DarkRed}#1\par}%
  \fi}
% Real stakeholder cover art (assets/img/processed/fm-cover.(png|jpg)), once
% it lands -- book.py wires this in fail-soft, same as the chapter openers.
% vol1 idiom: full-bleed art BEHIND the title text, not beside it. eso-pic's
% STARRED \AddToShipoutPictureBG* queues a one-shot background for the very
% next \shipout only (unlike the persistent \liturgyparchment hook above,
% which re-fires every page) -- called from the cover page's own content, it
% layers over that page's parchment (starred hooks run after the persistent
% ones already queued) without touching any other page's background.
\newcommand{\covercoverart}[1]{%
  \AddToShipoutPictureBG*{\AtPageLowerLeft{\includegraphics[width=\paperwidth,height=\paperheight]{#1}}}%
}
% Real stakeholder "Reading This Book" sidebar art
% (assets/img/processed/fm-reading.(png|jpg)). The right column it fills is
% ALREADY reserved by the page's own \columnbreak (frontmatter.md's
% \column directive inside a 2-column \multicols) -- unlike the chapter
% openers there is no tikz-overlay reservation to match, so this is a plain
% in-flow image sized to the column measure.
\newcommand{\readingartimage}[1]{\includegraphics[width=\linewidth]{#1}\par}
% one contents-page row: chapter number, title, \pageref label (tectonic
% resolves \pageref automatically via its built-in multi-pass rerun).
%
% ⭐ THE row-height corruption bug (bisected against the FULL 8-chapter book
% -- never reproducible in an isolated single-table document, exactly like
% the \rowcolors counter this table's \rowcolor already ruled out): calling
% \pageref while \mreaves sits at a FRESH \fontsize{}{}\selectfont value
% (i.e. NOT the already-active ambient size) corrupts \strutbox's HEIGHT
% component for the REST OF THE DOCUMENT COMPILE -- surfacing as a handful
% of spell-list-table data rows (in EVERY one of the 8 chapter tables, not
% just this one) rendering ~19pt taller than their neighbors, with a blank
% gap above the row's own text (confirmed via \tracingoutput box dumps:
% array's \@arstrutbox height triples on exactly those rows' non-centered
% p{}/X columns while the centered columns and the cell's OWN internal line
% strut stay normal). Root cause isolated empirically (fontspec/XeTeX
% font-metric loading interacting with \pageref's deferred/\protect'd
% expansion when the reference is still unresolved on an intervening pass
% -- \label/\pageref alone reproduce it with hyperref fully disabled, so
% this is NOT a hyperref bug); no \edef/\protected@edef pre-resolution
% trick survives (hyperref's \pageref is fundamentally not \edef-safe --
% it either crashes outright on an undefined target or, once safely
% deferred via \protected@edef, still performs its real expansion at
% typeset time inside the very font context we needed to avoid). The
% ONLY reliable fix found: never let \pageref's typeset-time expansion
% happen while a freshly-\fontsize'd size is active -- \pageref#3} is
% wrapped in its own group that drops back to \normalsize (the document's
% own already-active ambient size, still \mreaves for the family) FIRST.
% The page number is typeset at \normalsize (safe) and then the finished
% BOX is \scalebox'd back up to match the 0.5cm entry text -- box scaling
% never touches the font-size machinery, so it cannot re-trigger the strut
% corruption the \normalsize drop avoids.
\newcommand{\tocentry}[3]{\noindent\hbox to \linewidth{\mreaves\fontsize{0.5cm}{0.6cm}\selectfont\color{DarkRed}Chapter #1 --- #2\hfill\scalebox{1.47}{{\normalsize\mreaves\pageref{#3}}}}\par\vspace{0.3cm}}

\endinput
