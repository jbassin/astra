{
  "name": "@astra/weal-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/ontology": "workspace:*",
    "@astra/pg-migrate": "workspace:*",
    "@astra/weal-engine": "workspace:*",
    "@astra/weal-wire": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "discord.js": "catalog:",
    "postgres": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@astra/site-kit": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "weal"
  }
}
