{
  "name": "astra",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives apps libs/ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --fix apps libs/ts vitest.config.ts",
    "format": "oxfmt --write 'apps/**/*.{js,jsx,ts,tsx,json,css}' 'libs/ts/**/*.{js,jsx,ts,tsx,json,css}' '*.{js,mjs,cjs,ts,json}'",
    "format:check": "oxfmt --check 'apps/**/*.{js,jsx,ts,tsx,json,css}' 'libs/ts/**/*.{js,jsx,ts,tsx,json,css}' '*.{js,mjs,cjs,ts,json}'",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@types/node": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "@types/node": "catalog:"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
