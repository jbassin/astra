{
  "name": "@astra/vellum-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner && tsdown --config-loader tsx",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "visual-regression": "node --import tsx scripts/visual-regression.ts",
    "visual-regression:update": "node --import tsx scripts/visual-regression.ts --update"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/gothic": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/service-kit": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@astra/vellum-lang": "workspace:*",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@opentelemetry/api": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "vellum-render"
  }
}
