{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The TS lint gate (`pnpm run lint`: --type-aware --deny-warnings
  // --report-unused-disable-directives). An exception for one line is an inline
  // `// oxlint-disable-next-line <rule> -- <why>` at that line, so it stays visible and
  // countable; `overrides` below is only for whole categories of file. Rules that are off
  // repo-wide are ratchets: their counts are in the 0037 paydown doc (Phase 1 item 4).
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Every frontend uses the automatic JSX runtime; this rule assumes the classic one.
    "react/react-in-jsx-scope": "off",

    // On beyond the categories.
    "no-non-null-assertion": "error",
    "prefer-template": "error",
    "no-explicit-any": "error",
    "array-callback-return": "error",
    "no-cond-assign": "error",
    "no-danger": "error",
    "role-supports-aria-props": "error",
    "no-array-index-key": "error",
    "prefer-tag-over-role": "error",
    "no-static-element-interactions": "error",
    "click-events-have-key-events": "error",
    "react/rules-of-hooks": "error",
    // `x == null` (null or undefined) is the one loose comparison allowed.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-console": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-at": "error",
    // Not for arguments or arrow bodies: some signatures require an explicit undefined.
    "unicorn/no-useless-undefined": [
      "error",
      { "checkArguments": false, "checkArrowFunctionBody": false }
    ],
    "unicorn/no-lonely-if": "error",
    "no-else-return": "error",
    "unicorn/explicit-length-check": "error",
    "eslint/require-await": "error",
    "no-floating-promises": "error",
    "no-unnecessary-type-assertion": "error",

    // astra's fire-and-forget terminal `.then()` (`void x.then(() => { sideEffect(); })`)
    // never chains further, so the last callback needn't return.
    "promise/always-return": ["error", { "ignoreLastCallback": true }],

    // Ratchets: off for now, to be turned on as their counts reach zero.
    "no-array-sort": "off",
    "no-array-reverse": "off",
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "consistent-function-scoping": "off",
    "no-unsafe-type-assertion": "off",
    "consistent-return": "off",
    "no-base-to-string": "off",
    "no-unnecessary-type-conversion": "off",
    "restrict-template-expressions": "off",
    "no-unnecessary-template-expression": "off",
    "no-unnecessary-boolean-literal-compare": "off",
    "unbound-method": "off",
    "no-unnecessary-type-parameters": "off",

    // Off for good. Each switch case here ends in its own `return`; this rule flags the
    // last one, and removing it exposes the one before, ending in fall-through chains.
    "no-useless-return": "off",
    // Pixi's `Graphics#fill(options)` matches this rule by method name,
    // with no type information to tell it from Array#fill.
    "no-array-fill-with-reference-type": "off",
    // Side-effect imports of global CSS, fonts and the RUM bootstrap at each entry point.
    "no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "**/being.canonical.json",
    "**/akasha-snapshot.json",
    "**/fixtures/vellum/**",
    "**/tests/fixtures/**",
    "**/linguist/data/**",
    "**/linguist/timeline/**",
    "**/routeTree.gen.ts",
    "**/src/generated/**",
    "**/public/**",
    "**/*.sdPlugin/**",
    "**/codex/web/data/**",
    "**/codex/web/fixtures/**",
    "**/weal-engine/gen/**"
  ],
  "overrides": [
    {
      // Build and maintenance scripts are command-line programs: the console is their output.
      "files": ["**/scripts/**"],
      "rules": { "no-console": "off" }
    },
    {
      // Tests: a wrong `!` fails the test that made it, and async mocks stand in for
      // async interfaces whether or not they await.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "rules": { "no-non-null-assertion": "off", "require-await": "off" }
    }
  ]
}
