# Build output (all site-gen lands here; served by Caddy)
dist/
# Each Node service's tsdown server bundle (libs/ts/site-kit/src/serverBundle.ts)
dist-server/
# …but the weal-engine's dist(ribution) module is source, not build output
# (the unanchored pattern above silently swallowed it — 0032 S4 merge)
!libs/rust/weal-engine/src/dist/

# Developer scratch (research notes, old logs). Runtime state no longer lives here: since
# 0037 item 2c all of it is under the data root /ruby/data/astra-state (config.kdl
# data.root), outside every checkout.
/artifacts/

# Storybook static build (gothic's dev/preview surface; regenerated, not source)
storybook-static/

# Secrets & edge config
#   - SOPS age/PGP private keys never enter git; the encrypted secret file does.
#   - The host-edge sites.caddyfile IS committed (token-free — {$CF_API_TOKEN} is
#     supplied from SOPS at reload, never written to the file).
*.agekey

# SOPS secrets directory — deny everything, then re-allow only what's safe to
# commit. Makes it impossible to accidentally commit the age PRIVATE key
# (deploy/sops/age.key); the .sops.yaml recipient list and *.enc.* ciphertext
# are public and stay tracked. See deploy/sops/README.md.
deploy/sops/*
!deploy/sops/README.md
!deploy/sops/.sops.yaml
!deploy/sops/*.enc.yaml
!deploy/sops/*.enc.json

.env
.env.*
!.env.example

# SigNoz runtime artifacts — init-clickhouse downloads the histogram-quantile
# binary into this bind-mounted dir on `up`; it's regenerated, not source.
deploy/signoz/common/clickhouse/user_scripts/*
!deploy/signoz/common/clickhouse/user_scripts/.gitkeep

# Python (uv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Node / bun
node_modules/

# Rust (defensive: astra is two-toolchain, but guard against stray target/)
target/

# OS / editor cruft
.DS_Store
apps/akasha/py/migrate/convert-report.json

# assay's Liturgy books (ADR 0018): the .tex, style, fonts and finished art are committed;
# every PDF (`just book` output), tectonic's compile log and the raw pre-crop art
# generations under preprocessed/ (local-only scratch) are not.
apps/assay/py/books/**/*.pdf
apps/assay/py/books/**/*.log
apps/assay/py/books/**/assets/img/preprocessed/

# The codex fixture corpus, generated from fixtures/picks, fixtures/raw and code
# (apps/codex/ingest/src/fixtureCorpus.ts), plus its in-progress build dirs.
apps/codex/ingest/fixtures/entities/
apps/codex/ingest/fixtures/.entities-build-*/

# Playwright MCP console logs + page snapshots (tool debris)
.playwright-mcp/
