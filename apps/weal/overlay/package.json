{
  "name": "@astra/weal-overlay",
  "version": "0.0.0",
  "private": true,
  "description": "Live dice-roll OBS overlay — ingests weal-bot's roll broadcast, fans it out over SSE, renders an animated ticker OBS captures as a Browser Source.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "dev:server": "node --import tsx --watch server.ts",
    "build": "vite build --configLoader runner && tsdown --config-loader tsx",
    "preview": "vite preview",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/gothic": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/service-kit": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@astra/weal-wire": "workspace:*",
    "@fontsource/ibm-plex-mono": "catalog:",
    "pixi.js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "weal-overlay"
  }
}
