% liturgy.sty --- Liturgy of the Iridite Vol.2 Homebrewery-look style layer
% Recreates the vol1 D&D-2024-PHB parchment look under tectonic/XeTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{liturgy}[2026/07/31 Liturgy of the Iridite book style]

% ---------------------------------------------------------------- geometry
\RequirePackage[letterpaper,top=1.4cm,left=1.9cm,right=1.9cm,bottom=1.7cm]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Bookinsanity.ttf}[
  Path = ./assets/fonts/,
  BoldFont = Bookinsanity_Bold.ttf,
  ItalicFont = Bookinsanity_Italic.ttf,
  BoldItalicFont = Bookinsanity_Bold_Italic.ttf]

\newfontfamily\scaly{Scaly_Sans.ttf}[Path=./assets/fonts/,
  BoldFont=Scaly_Sans_Bold.ttf, ItalicFont=Scaly_Sans_Italic.ttf]
% Scaly Sans Small Caps has no shipped bold face -- FakeBold synthesizes one
% (approximation: not a true bold-weight small-caps design).
\newfontfamily\scalycaps{Scaly_Sans_Caps.ttf}[Path=./assets/fonts/]
\newfontfamily\scalycapsbold{Scaly_Sans_Caps.ttf}[Path=./assets/fonts/, FakeBold=2.2]
\newfontfamily\mreaves{Mr_Eaves_Small_Caps.ttf}[Path=./assets/fonts/]
\newfontfamily\wolpe{WolpePegasus.ttf}[Path=./assets/fonts/]
\newfontfamily\optipegasus{OPTIPegasus.ttf}[Path=./assets/fonts/]
\newfontfamily\actionfont{Pathfinder2eActions.ttf}[Path=./assets/fonts/]

% body: BookInsanityRemake ~9.6pt / 1.25 leading; 0.325cm paragraph spacing
\renewcommand{\normalsize}{\fontsize{9.6pt}{12pt}\selectfont}
\normalsize
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.325cm}

% tighter intra-block paragraph spacing for spell-block flow (body prose,
% consecutive \heightened entries). The default \parskip above is sized for
% flowing chapter-opener prose; call \spellflow once at the start of a
% spell-listing region (e.g. right after \begin{multicols} on the spell
% pages) to tighten paragraph gaps WITHIN blocks. Separation BETWEEN blocks
% stays large because it is the explicit \vspace{8pt} + \blockrule (both
% independent of \parskip), not this register.
\newcommand{\spellflow}{\setlength{\parskip}{0.15cm}}

