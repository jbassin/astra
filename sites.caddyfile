# astra host-edge sites — imported by the shared reverse proxy at
# /ruby/data/reverse-proxy/Caddyfile (custom caddy binary w/ the cloudflare-dns
# plugin), the same way faerrin's sites.caddyfile is. Add this line to that file:
#   import /ruby/data/astra-deploy/sites.caddyfile   (the deploy checkout)
# (and drop faerrin's strider import — both can't own strider.iridi.cc at once).
#
# Frontends are SSR Compose services, REVERSE-PROXIED here (not the
# static `file_server` faerrin used). Reload with `just caddy-reload`.
#
# The Cloudflare ACME-DNS token is NOT committed: `{$CF_API_TOKEN}` is substituted
# at config-adapt time from the SOPS-decrypted value the reload command exports —
# so the token is never written to this file or to disk.
#
# At boot the token comes from the root-only /etc/caddy-cf.env, loaded by the
# systemd drop-in caddy.service.d/cf-token.conf (added 2026-09-28). Before that,
# renewal jobs created at boot kept the placeholder token for the life of the
# process (a reload does not replace them), and certs expired unnoticed for a
# week. The `:unset-at-boot` default stays as a guard: it keeps the Caddyfile
# parseable if the env file is ever missing (a missing token took the whole edge
# down on 2026-07-29).
#
# No DNS propagation check: `*.iridi.cc` is a wildcard CNAME to iridi.cc, and
# Cloudflare answers the CNAME lookup for `_acme-challenge.<host>.iridi.cc`
# with it even when the challenge TXT exists. Caddy's check follows that CNAME,
# looks for the TXT at iridi.cc, and times out. So skip the check and wait a
# fixed delay before asking Let's Encrypt to validate (it queries TXT directly).
#
# DNS and certificates for a new site block: the `*.iridi.cc` wildcard CNAME already
# resolves every subdomain, so a new host needs no DNS record. Each host gets its own
# certificate (no wildcard cert, no on-demand TLS): Caddy requests it through the
# Cloudflare DNS challenge as soon as a reload loads the block, and the host fails TLS
# handshakes until it arrives (at least the 60s propagation delay).

(astra_site) {
	tls {
		issuer acme {
			dns cloudflare {$CF_API_TOKEN:unset-at-boot}
			propagation_delay 60s
			propagation_timeout -1
			resolvers 1.1.1.1 8.8.8.8
		}
	}

	encode zstd gzip

	header -Server
	header -X-Powered-By
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options SAMEORIGIN
	header ?Strict-Transport-Security "max-age=31536000"

	# Health paths are LAN-only on every host: a public client gets a bare 404. The services'
	# /healthz (service-kit; orator's runs a Postgres ping), vellum-render and portal's /health,
	# and orator's legacy /api/v1/health. The ranges are local_only's. Nothing internal loses
	# its probe: compose healthchecks and the codex release prune call the container port, the
	# deploy health wait and host-metrics read Docker, and astra-smoke and Uptime Kuma go through
	# this edge from the LAN (hairpin NAT: the router hands them over as 192.168.0.1). A `handle`
	# so it runs before each site's own handle blocks; astra_site is imported first, so it wins
	# the overlap with vellum's @render (which also routes /health).
	@public_health {
		path /healthz /healthz/* /health /health/* /api/v1/health /api/v1/health/*
		not client_ip private_ranges 100.64.0.0/10
	}
	handle @public_health {
		respond 404
	}
}

# NB: (local_only) — gate to private IPs — is already defined by the parent
# reverse-proxy Caddyfile; blocks here can `import local_only` directly (don't
# redeclare it, that collides on reload).

# strider — the first SSR frontend (the later frontends' blocks follow). The
# compose `strider` service publishes host port 10360. It self-serves gothic's
# fonts from dist/ (site-kit's gothicFontsPlugin copies them in at build), so
# /fonts/* falls through to the reverse_proxy — no gothic_fonts import, matching
# orator/weal-overlay. The later frontends inherit this.
strider.iridi.cc {
	import astra_site

	# Editor UI — local network only (import local_only → "Access Denied" for
	# non-private clients). The save runs as a TanStack server function (POST to
	# /_serverFn/*, not a gateable path), so this gate is on the UI that invokes
	# it; the function is server-only and obscure, but not itself IP-restricted.
	@editor path /editor /editor/*
	handle @editor {
		import local_only
		reverse_proxy localhost:10360
	}

	handle {
		reverse_proxy localhost:10360
	}
}

# akasha-frontend — the wiki read-surface, the second SSR frontend on the
# strider template. A read-only surface (no /editor), so no local_only gate. Like
# strider it self-serves gothic's fonts from dist/ (gothicFontsPlugin), so /fonts/*
# falls through to the reverse_proxy. /pagefind/* (the search index) is likewise just
# static under dist/client. Compose publishes host port 10365.
akasha.iridi.cc {
	import astra_site
	reverse_proxy localhost:10365
}

# api.akasha.iridi.cc — raw session-script JSON straight off the astra-data clone's
# working tree (config data.linguist-data: the same committed linguist/data/*.json the
# public github.com/jbassin/astra-data repo serves; corrections
# already applied at processing time). `browse` auto-generates the index at
# /scripts/. Already public via the GitHub repo, so no gate. Caddy runs as
# uid 1000 post the run-as-1000 cutover, so it reads the clone directly.
api.akasha.iridi.cc {
	import astra_site
	redir / /scripts/ 302
	handle_path /scripts* {
		root * /ruby/data/astra-state/astra-data/linguist/data
		# The directory index renders as a bare JSON array of full file URLs
		# (deploy/caddy/scripts-index.tmpl) instead of the default browse.html.
		header {
			Content-Type application/json
			defer
		}
		file_server {
			hide *.candidates.json
			browse /ruby/data/astra-deploy/deploy/caddy/scripts-index.tmpl
		}
	}
}

# heart.iridi.cc — alias host for akasha-frontend (same SSR service, port 10365).
heart.iridi.cc {
	import astra_site
	reverse_proxy localhost:10365
}

# mouthpiece-frontend — the podcast read-surface, the third SSR frontend on the
# strider/akasha template. Read-only (no /editor → no local_only gate). Self-serves
# gothic's fonts from dist/; /audio/<id>.mp3 is served by the SSR process off the
# mounted audio volume, so it falls through to the reverse_proxy like any other
# path. Compose publishes host port 10366.
mouthpiece.iridi.cc {
	import astra_site
	reverse_proxy localhost:10366
}

# harrow — the tarot deck reader, a backend-less SSR frontend on the strider
# template. Read-only (no editor); self-serves gothic's fonts from the
# container. Compose publishes host port 10369. This block took the host over from the
# old standalone deploy, whose stanza is gone from the parent reverse-proxy Caddyfile.
harrow.iridi.cc {
	import astra_site
	reverse_proxy localhost:10369
}

# ledger — the astra landing page, the simplest SSR frontend, a sibling of
# harrow. One homepage: a gothic card grid linking the player-facing sites (the links
# are baked from each site's config public-origin at build time). Read-only (no
# editor → no local_only gate); self-serves gothic's fonts from the container. Compose
# publishes host port 10370.
ledger.iridi.cc {
	import astra_site
	reverse_proxy localhost:10370
}

# codex — the PF2e compendium/rules browser, SSR frontend on port 10374.
# Public with NO auth gate but NOINDEXED: the X-Robots-Tag header here is
# layer 3 of 3 (the SSR HTML always carries a robots meta tag; /robots.txt Disallow-all
# ships in the app's public/). Plain `header` (not `header ?`) — this must always win.
codex.iridi.cc {
	import astra_site
	header X-Robots-Tag noindex
	reverse_proxy localhost:10374
}

# 2e.iridi.cc — alias host for codex (same SSR service, port 10374). Mirrors the
# heart.iridi.cc alias precedent above: same upstream, same noindex posture (still
# public, no auth, three-layer noindexed; the header here is layer 3, same as
# codex.iridi.cc's own).
2e.iridi.cc {
	import astra_site
	header X-Robots-Tag noindex
	reverse_proxy localhost:10374
}

# vellum-frontend — the document-forge editor, the fourth SSR frontend on the
# strider/akasha template. Two upstreams (mirroring faerrin's old vellum block):
# /render + /health proxy to the vellum-render service (the PNG render sidecar), so the
# editor's export POSTs same-origin; everything else (the editor + preview) goes to the
# SSR frontend. The /editor UI is gated local_only (like strider) — the export still
# works for local clients; a public visitor sees the read-only landing page. Self-serves
# gothic's fonts from the container. Compose publishes 10367 (frontend) + 10368 (render).
vellum.iridi.cc {
	import astra_site

	# The PNG render API → the vellum-render service (warm Chromium, egress-blocked,
	# semaphore-gated). Same-origin so the editor needs no CORS / env var. /health is
	# LAN-only (astra_site's health gate). request_body caps the body at 1MB (over the cap
	# → 413): the service rejects a source over 64 KiB, and JSON escaping can grow a valid
	# source to at most 6× that (~384 KiB) as a body; the largest real document is ~9 KB.
	@render path /render /health
	handle @render {
		request_body {
			max_size 1MB
		}
		reverse_proxy localhost:10368
	}

	# Editor UI — local network only (import local_only → "Access Denied" for
	# non-private clients). Same posture as strider's editor.
	@editor path /editor /editor/*
	handle @editor {
		import local_only
		reverse_proxy localhost:10367
	}

	handle {
		reverse_proxy localhost:10367
	}
}

# weal-overlay — the dice-roll OBS overlay. SSE: flush_interval -1 disables
# response buffering so text/event-stream reaches OBS immediately. The overlay
# self-serves its fonts from dist/, so no gothic_fonts import. Compose publishes
# host port 10361.
weal-overlay.iridi.cc {
	import astra_site
	reverse_proxy localhost:10361 {
		flush_interval -1
	}
}

# orator-backend — the Discord music console: Bun.serve REST + the served
# operator SPA (one origin, M3). The SPA self-serves its gothic fonts from dist/
# (gothicFontsPlugin copies them in), so no gothic_fonts import. Auth is handled in
# the app (Discord OAuth + ontology allowlist), so no IP gate. Compose publishes
# host port 10363.
orator.iridi.cc {
	import astra_site

	# SSE: the ingest job-progress stream (EventSource) needs unbuffered proxying
	# so text/event-stream reaches the browser immediately.
	@sse path /api/v1/ingest/jobs/*/events
	handle @sse {
		reverse_proxy localhost:10363 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:10363
	}
}

# portal — the FoundryVTT MCP+WS bridge server. Two upstream concerns on one
# origin: the SSE-shaped Streamable-HTTP `/mcp` surface + the bridge `/ws` upgrade
# (flush_interval -1, mirroring weal-overlay/orator's SSE matchers — WS upgrades need
# the same unbuffered proxying), and an explicit `/module/*` route so Foundry's
# server-side manifest fetch resolves cleanly (D11 — install by Manifest URL =
# https://portal.iridi.cc/module/module.json; the catch-all would cover it too, but
# the explicit route documents intent + lets caching be tuned here later). Compose
# publishes host port 10372.
portal.iridi.cc {
	import astra_site

	@sse path /ws /mcp
	handle @sse {
		reverse_proxy localhost:10372 {
			flush_interval -1
		}
	}

	handle /module/* {
		reverse_proxy localhost:10372
	}

	handle {
		reverse_proxy localhost:10372
	}
}

# menhir — the Kahoot-style session-opener quiz, a Compose SSE service on
# port 10375. No auth (stakeholder choice; per-game hostToken guards host actions).
# Noindexed 3-layer like codex (meta + robots.txt in the app, header here). The
# SSE event stream needs unbuffered proxying (weal-overlay/orator posture) — the
# handle-wrapped matcher keeps the catch-all from claiming /api/events/* (which
# would silently buffer EventSource frames).
menhir.iridi.cc {
	import astra_site
	header X-Robots-Tag noindex

	@sse path /api/events/*
	handle @sse {
		reverse_proxy localhost:10375 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:10375
	}
}

# OTLP/HTTP ingest for browser RUM (config.kdl telemetry.rum-endpoint points
# here). Reverse-proxies the SigNoz collector's host port; the collector has no
# CORS of its own, so reflect it here for *.iridi.cc frontends only.
otel.iridi.cc {
	import astra_site

	@preflight {
		method OPTIONS
		header_regexp Origin ^https://([a-z0-9-]+\.)?iridi\.cc$
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	@iridi header_regexp Origin ^https://([a-z0-9-]+\.)?iridi\.cc$
	handle @iridi {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Vary Origin
		reverse_proxy localhost:10353
	}

	handle {
		reverse_proxy localhost:10353
	}
}

# SigNoz UI — the observability single pane (deploy substrate). Local network
# only: import local_only denies non-private clients for the whole site.
signoz.iridi.cc {
	import astra_site
	import local_only
	reverse_proxy localhost:10351
}

# Dagster UI — the pipeline control plane (run/asset/sensor management). Internal
# admin surface, so local network only (import local_only). Compose's dagster-webserver
# publishes host port 10350.
dagster.iridi.cc {
	import astra_site
	import local_only
	reverse_proxy localhost:10350
}
