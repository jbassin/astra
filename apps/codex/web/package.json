{
  "name": "@astra/codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner && tsdown --config-loader tsx",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "regen-goldens": "node --import ../../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/regen-goldens.ts",
    "row-height-drift-guard": "node --import ../../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/rowHeightDriftGuard.ts",
    "virtualization-interaction-guard": "node --import ../../../libs/ts/site-kit/src/nodeTsResolve.mjs scripts/virtualizationInteractionGuard.ts"
  },
  "dependencies": {
    "@astra/codex-corpus": "workspace:*",
    "@astra/config": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "@fontsource/cinzel": "catalog:",
    "@fontsource/cormorant-sc": "catalog:",
    "@fontsource/eb-garamond": "catalog:",
    "@fontsource/oswald": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-virtual": "^3.14.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astra/codex-ingest": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "codex"
  }
}
