        },
        {
          "content": " ",
          "kind": "text",
          "marks": {
            "bold": false,
            "italic": false,
            "superscript": false
          }
        },
        {
          "content": "(material, somatic, verbal)",
          "kind": "text",
          "marks": {
            "bold": true,
            "italic": false,
            "superscript": false
          }
        },
        {
          "content": " You disperse positive energy in a 30-foot emanation. This targets all living and undead creatures in the burst.",
