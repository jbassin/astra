            "bold": true,
            "italic": false,
            "superscript": false
          }
        },
        {
          "content": " Loyalty is up across the board. Reduce Unrest by 1d4.\n ",
          "kind": "text",
          "marks": {
            "bold": false,
            "italic": false,
            "superscript": false
          }
        },
        {
