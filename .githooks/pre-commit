#!/bin/sh
# astra pre-commit gate: `just check`, the fast format + lint subset of CI (oxlint +
# oxfmt for TS, ruff for Python, warnings treated as errors), over the whole tree.
# Check-only: it never modifies your files. Typecheck and tests run in the pre-push
# hook (`just ci`) and in CI.
#
# Installed by `just bootstrap` and by the root package.json "prepare" script
# (git config core.hooksPath .githooks).
# Bypass in a genuine emergency with:  git commit --no-verify
set -u

if ! command -v just >/dev/null 2>&1; then
  echo "✖ pre-commit: just not found (run 'just bootstrap', or activate mise)" >&2
  exit 1
fi

# git runs hooks with GIT_DIR, GIT_INDEX_FILE and friends exported; clear them so no tool
# the gate runs mistakes another directory for this repo (see pre-push).
for var in $(env | sed -n 's/^\(GIT_[A-Z_]*\)=.*/\1/p'); do unset "$var"; done

if ! just check; then
  echo "" >&2
  echo "commit blocked. fix with:  just fix" >&2
  echo "(emergency bypass:          git commit --no-verify)" >&2
  exit 1
fi
