# Build output (all site-gen lands here; served by Caddy)
dist/

# Runtime artifacts — the single bind-mount root for state that used to live in named
# Docker volumes (audio + Postgres data). Created/owned by the host (uid 1000) so the
# containers (now run as 1000:1000) write host-owned files; never committed. See the
# `artifacts-init` justfile recipe and deploy/docker-compose.yml.
/artifacts/

# Storybook static build (gothic's dev/preview surface; regenerated, not source)
storybook-static/

# Secrets & edge config
#   - SOPS age/PGP private keys never enter git; the encrypted secret file does.
#   - The host-edge sites.caddyfile IS committed (token-free — {$CF_API_TOKEN} is
#     supplied from SOPS at reload, never written to the file).
*.agekey

# SOPS secrets directory — deny everything, then re-allow only what's safe to
# commit. Makes it impossible to accidentally commit the age PRIVATE key
# (deploy/sops/age.key); the .sops.yaml recipient list and *.enc.* ciphertext
# are public and stay tracked. See deploy/sops/README.md.
deploy/sops/*
!deploy/sops/README.md
!deploy/sops/.sops.yaml
!deploy/sops/*.enc.yaml
!deploy/sops/*.enc.json

.env
.env.*
!.env.example

# SigNoz runtime artifacts — init-clickhouse downloads the histogram-quantile
# binary into this bind-mounted dir on `up`; it's regenerated, not source.
deploy/signoz/common/clickhouse/user_scripts/*
!deploy/signoz/common/clickhouse/user_scripts/.gitkeep

# Python (uv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Node / bun
node_modules/

# Rust (defensive: astra is two-toolchain, but guard against stray target/)
target/

# OS / editor cruft
.DS_Store
apps/akasha-backend/migrate/convert-report.json

# linguist surfacer review state — per-session candidate triage files (surface.py
# output, reviewed in review_tui, applied to defs.yaml via apply.py); not source.
apps/linguist/data/*.candidates.json

# scribe runtime data — Craig zips (incoming/) + extracted audio.mp3/script.json
# (data/saved/{date}/); transient pipeline I/O on this deploy, not source.
apps/scribe/incoming/
apps/scribe/data/

# codex runtime data — the fetched PF2e corpus (foundryvtt/pf2e packs + AoN ES
# docs); build-time ingest output, not source, and re-fetchable.
apps/codex/data/

# Pipeline output dirs bind-mounted into the Dagster services (deploy/docker-compose).
# Keep the dir (a .gitkeep so the bind-mount source exists on clone), ignore the live
# pipeline writes. (linguist/transcripts + linguist/data keep their committed historical
# data, so they're NOT ignored — live writes there are uncommitted operator state.)
apps/scribe/tmp/*
!apps/scribe/tmp/.gitkeep
apps/linguist/script/*
!apps/linguist/script/.gitkeep
apps/mouthpiece-backend/episodes/*
!apps/mouthpiece-backend/episodes/.gitkeep

# Book references — keep the .tex/.md sources, not scratch-rendered PDFs
# (re-exportable; vol1 was Homebrewery, vol2 is `uv run assay export-book`'s
# tectonic compile). vol2's OWN compiled PDF is the committed book artifact
# (S2 LaTeX cutover) — tracked explicitly below; every other PDF under
# books/ (vol1, any local scratch renders) stays ignored.
apps/codex/books/**/*.pdf
!apps/codex/books/liturgy_vol2/liturgy_of_the_iridite_vol2.pdf
