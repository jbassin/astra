{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    // Frontend-lane override (same as apps/ledger/heartwood-frontend): server-only
    // imports must stay out of anything the client bundle pulls in.
    "verbatimModuleSyntax": false,
    "types": ["node", "react", "react-dom", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", ".output", ".nitro"]
}
