[Unit]
Description=Auto-commit + push new linguist transcripts/data (pipeline source-of-record) for astra
Documentation=https://github.com/jbassin/astra
# Class C alerting: page Discord directly on failure (e.g. a push that keeps failing). The
# handler decrypts the webhook from SOPS at runtime. %n = linguist-commit.service.
OnFailure=astra-alert@%n.service

[Service]
Type=oneshot
# Runs the recipe from the deploy checkout (0037 item 2c), with the venv deploy.sh keeps in
# sync there; every path it touches comes from config.kdl, under the data root
# /ruby/data/astra-state, never this checkout.
WorkingDirectory=/ruby/data/astra-deploy
# `just` lives in the user's cargo bin. The recipe commits the linguist datasets the Dagster
# run workers write into the astra-data clone (via bind mounts), refreshes the mouthpiece
# snapshot, pushes the clone and redeploys the frontends. Runs as the user (not in a
# container) so it has git, the git identity and the SSH push key; the Dagster containers
# have none of those.
ExecStart=/home/jbassin/.cargo/bin/just linguist-commit
