{
  "name": "astra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@types/node": "^24.13.2",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.13.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
