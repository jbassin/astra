{
  "alert": "saffron disk degradation counters",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "description": "SMART attribute {{$name}} on {{$disk}} rose above 0 (now {{$value}}). Reallocated/pending sectors predict failure; UDMA_CRC_Error_Count points at the SATA cable.",
    "summary": "{{$disk}}: {{$name}} is {{$value}}"
  },
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "smartmon_attr_raw_value",
                "spaceAggregation": "max",
                "timeAggregation": "max"
              }
            ],
            "filter": {
              "expression": "name IN ('Reallocated_Sector_Ct','Current_Pending_Sector','Offline_Uncorrectable','Reported_Uncorrect','UDMA_CRC_Error_Count')"
            },
            "groupBy": [
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "disk"
              },
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "name"
              }
            ],
            "legend": "{{disk}} {{name}}",
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "discord-ops"
          ],
          "matchType": "at_least_once",
          "name": "warning",
          "op": "above",
          "recoveryTarget": null,
          "target": 0
        }
      ]
    }
  },
  "description": "Early-warning ATA SMART counters on saffron went above zero: reallocated, pending, or offline-uncorrectable sectors, reported uncorrectable reads, or SATA-cable UDMA CRC errors.",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "5m"
    }
  },
  "labels": {
    "host": "saffron",
    "severity": "warning"
  },
  "notificationSettings": {
    "groupBy": [
      "disk",
      "name"
    ],
    "renotify": {
      "alertStates": [
        "firing"
      ],
      "enabled": true,
      "interval": "24h"
    }
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "source": "mcp",
  "version": "v5"
}
