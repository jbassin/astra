/* __name__'s page shell on gothic. gothic's theme.css (imported in __root through
 * @astra/site-kit/theme) provides the tokens and the reset baseline; this file owns the layout. */

/* In @layer base so it sits below gothic's @layer components content styles: unlayered, a bare
   reset zeroes the margins and padding of rendered vellum content. */
@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
}

html,
body {
  height: 100%;
}
html {
  background-color: var(--color-void);
}
body {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  color: var(--color-ink);
  font-family: var(--font-body), serif;
  font-size: 18px;
  line-height: 1.6;
}

.site-head {
  display: flex;
  align-items: baseline;
  gap: 1.25rem;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-panel);
}
.site-brand {
  font-family: var(--font-display), serif;
  font-size: 1.4rem;
  letter-spacing: 0.04em;
  color: var(--color-ink);
  text-decoration: none;
}

.wrap {
  flex: 1;
  width: 100%;
  max-width: 52rem;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

/* The router's error and 404 boundaries (site-kit's siteRouterOptions). */
.route-boundary {
  flex: 1;
  display: grid;
  place-content: center;
  gap: 0.75rem;
  padding: 3rem;
  text-align: center;
}
.route-boundary button {
  justify-self: center;
  padding: 0.5rem 1.2rem;
  border: 1px solid var(--color-accent);
  border-radius: 0.4rem;
  background: transparent;
  color: var(--color-accent);
  cursor: pointer;
  font-family: var(--font-mono), monospace;
}
