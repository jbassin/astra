{
  "name": "@astra/builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner && tsdown --config-loader tsx",
    "start": "node --import ./dist-server/register.mjs dist-server/main.mjs",
    "typecheck": "node --import tsx scripts/build-content.ts && tsc --noEmit",
    "test": "vitest run",
    "generate:content": "node --import tsx scripts/build-content.ts"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/content-build": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/service-kit": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@fontsource-variable/atkinson-hyperlegible-next": "catalog:",
    "@fontsource-variable/texturina": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.151",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "astra": {
    "config": "builder"
  }
}
