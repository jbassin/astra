{"data":{"alert":"saffron filesystem filling up","alertType":"METRIC_BASED_ALERT","annotations":{"description":"Filesystem {{$mountpoint}} on saffron is {{$value}}% used (threshold {{$threshold}}%). Free up space or expand.","summary":"{{$mountpoint}} is {{$value}}% full"},"condition":{"compositeQuery":{"queries":[{"type":"builder_query","spec":{"name":"A","stepInterval":60,"signal":"metrics","source":"","aggregations":[{"metricName":"node_filesystem_avail_bytes","temporality":"","timeAggregation":"min","spaceAggregation":"min","reduceTo":""}],"disabled":true,"filter":{"expression":"fstype IN ('ext4','xfs')"},"groupBy":[{"name":"mountpoint","fieldContext":"attribute","fieldDataType":"string"}]}},{"type":"builder_query","spec":{"name":"B","stepInterval":60,"signal":"metrics","source":"","aggregations":[{"metricName":"node_filesystem_size_bytes","temporality":"","timeAggregation":"max","spaceAggregation":"max","reduceTo":""}],"disabled":true,"filter":{"expression":"fstype IN ('ext4','xfs')"},"groupBy":[{"name":"mountpoint","fieldContext":"attribute","fieldDataType":"string"}]}},{"type":"builder_formula","spec":{"name":"F1","expression":"(1 - A/B) * 100","legend":"{{mountpoint}}"}}],"panelType":"graph","queryType":"builder","unit":"percent"},"selectedQueryName":"F1","thresholds":{"kind":"basic","spec":[{"name":"warning","target":85,"targetUnit":"","recoveryTarget":80,"matchType":"at_least_once","op":"above","channels":["discord-ops"]},{"name":"critical","target":95,"targetUnit":"","recoveryTarget":90,"matchType":"at_least_once","op":"above","channels":["discord-ops"]}]}},"createdAt":"2026-08-19T23:34:53.657843Z","createdBy":"claude@signozserviceaccount.com","description":"A real filesystem on saffron (ext4/xfs: /, /boot, /ruby, plex data disk) is above 85% (warning) or 95% (critical) used.","disabled":false,"evaluation":{"kind":"rolling","spec":{"evalWindow":"15m","frequency":"5m"}},"id":"01a01c60-afd9-7ce6-8e9c-325e6f0d56a5","labels":{"host":"saffron","severity":"crit