{
  "alert": "saffron disk SMART failure",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "description": "smartmon_smart_status_passed for {{$disk}} has been {{$value}} for 15 minutes — the drive self-reports imminent failure (or SMART data went absent). Back up and replace.",
    "summary": "Disk {{$disk}} on saffron failed SMART"
  },
  "condition": {
    "absentFor": 30,
    "alertOnAbsent": true,
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "smartmon_smart_status_passed",
                "spaceAggregation": "min",
                "timeAggregation": "min"
              }
            ],
            "groupBy": [
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "disk"
              }
            ],
            "legend": "{{disk}}",
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "discord-ops"
          ],
          "matchType": "all_the_times",
          "name": "critical",
          "op": "below",
          "recoveryTarget": null,
          "target": 1,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A disk on saffron reports SMART overall-health FAILED (smartmon_smart_status_passed = 0) for the whole 15-minute window, or SMART data stopped arriving for 30 minutes (smart-exporter dead). Sustained, not any single sample: stopping node-exporter emits one 0 sample per disk at shutdown (seen 2026-10-23 during a deploy). Covers sda (16TB Exos plexdata), nvme0, nvme1.",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "5m"
    }
  },
  "labels": {
    "host": "saffron",
    "severity": "critical"
  },
  "notificationSettings": {
    "groupBy": [
      "disk"
    ],
    "renotify": {
      "alertStates": [
        "firing",
        "nodata"
      ],
      "enabled": true,
      "interval": "4h"
    }
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "source": "mcp",
  "version": "v5"
}
