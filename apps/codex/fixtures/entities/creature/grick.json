    {
      "children": [
        {
          "children": [
            {
              "content": "Jungle Gricks",
              "kind": "text",
              "marks": {
                "bold": false,
                "italic": false,
                "superscript": false
              }
            }
          ],
          "kind": "heading",
          "level": 2
        },
        {
          "children": [
            {
              "content": "These surface-adapted varieties of the underground grick appear in shades of green. They lurk in the undergrowth of jungles or climb low-hanging branches to drop on unsuspecting prey. Their greater skill at ",
              "kind": "text",
              "marks": {
                "bold": false,
                "italic": false,
                "superscript": false
              }
            },
            {
              "display": "Stealth",
              "kind": "crossref",
              "targetId": "skill/stealth"
            },
            {
              "content": " checks applies in forested terrain instead of rocky terrain. Jungle gricks are heartier creatures than their underground-dwelling kin; all jungle gricks have the ",
              "kind": "text",
              "marks": {
                "bold": false,
                "italic": false,
                "superscript": false
              }
            },
            {
              "display": "elite creature adjustments",
              "kind": "crossref",
              "targetId": "rules/elite-adjustment"
            },
            {
              "content": " as a result.",
              "kind": "text",
              "marks": {
                "bold": false,
                "italic": false,
                "superscript": false
              }
            }
          ],
          "kind": "paragraph"
        }
      ],
      "kind": "aside"
    }
