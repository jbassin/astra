{
  "name": "@astra/weal-overlay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live dice-roll OBS overlay — ingests weal-bot's v1 roll broadcast, fans it out over SSE, renders an animated ticker OBS captures as a Browser Source.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs --watch server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@astra/gothic": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "srvx": "0.11.20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.2",
    "vite": "8.1.3",
    "vitest": "^4.1.9"
  }
}
