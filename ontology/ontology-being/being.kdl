// astra ontology-being — the META truth store (roadmap 0002 §B).
//
// Consolidates three faerrin sources into one tree:
//   * mouth/players.toml            → players (snowflakes, player_id, is_dm/admin)
//   * content/scripts/campaigns.yaml → campaigns + per-campaign player→PC roster + descs
//   * content/scripts/lib/roster.ts  → recording-id aliases + identity colors
//
// This is META (who plays whom, host send-identities, podcast personas) — NOT in-world
// setting characters (those are akasha). `player-id` integers are load-bearing dice FKs
// (preserve verbatim). Identity color hexes are owned here (I5): the player values are the
// live-site (aether theme.scss) set; host hexes come from mouth/host.rs.

// --- players (the real people) -------------------------------------------------------

player "josh" {
    name "Josh"
    player-id 1
    snowflakes "333321567926878209"
    aliases "jbassin" "iiri__"
    is-dm #true
    is-admin #true
    color "rgb(232,184,232)"
}

player "jorge" {
    name "Jorge"
    player-id 2
    snowflakes "712150290169593856" "753011285003730955"
    aliases "boiledpacakes"
    is-dm #false
    is-admin #false
    color "rgb(143,216,240)"
}

player "mike" {
    name "Mike"
    player-id 3
    snowflakes "555850241912602631"
    aliases "miked6187"
    is-dm #false
    is-admin #false
    color "rgb(255,173,173)"
}

player "noah" {
    name "Noah"
    player-id 4
    snowflakes "652106046571020299"
    aliases "nnaiman"
    is-dm #false
    is-admin #false
    color "rgb(184,212,168)"
}

player "tanner" {
    name "Tanner"
    player-id 5
    snowflakes "417896818844893194"
    aliases "tanner_kn" "tanner"
    is-dm #false
    is-admin #false
    color "rgb(255,214,165)"
}

// Fallback color for unknown/guest speakers (roster.ts GUEST_COLOR).
guest-color "rgb(235,235,236)"

// --- campaigns (player → the PC[s] they play; "Gamemaster" marks the GM role) --------

campaign "through-a-song-darkly" {
    name "Through a Song, Darkly"
    edition "pathfinder_2e"
    main #true
    role player="josh" character="Gamemaster" class="gm"
    role player="jorge" character="Argyle" class="champion" {
        desc "Formerly a failed celestial and repentant devil both inhabiting an elven body."
        desc "The two halves have been separated and spread across the Infinite Horizon."
        desc "Now only the celestial, and a custode from the Scale on loan to Iconoclasm."
    }
    role player="jorge" character="Arctos" {
        desc "A polar bear, awakened by the grace of the Iridescent Host"
        desc "Once a pet for a young Minister Vane, who would grow up to become a Calarian council member"
    }
    role player="mike" character="Benny" class="fighter" {
        desc "A nine-year-old android with the visage (and personality) of a child but the martial prowess of an adult"
        desc "The son of Atum, a high-ranking heart from Belvedere. His full name is Bennix."
    }
    role player="noah" character="Johnny" class="bard" {
        desc "A half-elven man from Raelion. Originally a bartender, but now a mid/high level member of the Ghosts of Raelion"
        desc "He was blessed by the Watcher to come back from death, to serve as some his eyes across the continent"
    }
    role player="tanner" character="Anzu" class="psychic" {
        desc "A tengu, a bird person. Black feathered with blue feathertips"
        desc "The scion of the Qureshi family, an aristocratic, well-known patron and member family of Belvedere. He's run away from home."
    }
}

campaign "interred-in-iomenei" {
    name "Interred in Iomenei"
    edition "pathfinder_2e"
    main #false
    role player="josh" character="Gamemaster" class="gm"
    role player="jorge" character="Grant" { desc "a worker from the Undercroft; a dwarf" }
    role player="mike" character="Gage" { desc "a worker from the Undercroft; a human" }
    role player="noah" character="Barlow" { desc "a worker from the Undercroft; an elf" }
    role player="tanner" character="Archie" { desc "a worker from the Undercroft; a human" }
}

