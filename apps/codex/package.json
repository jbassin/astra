{
  "name": "@astra/codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner",
    "start": "node --import ../../libs/ts/site-kit/src/nodeTsResolve.mjs server.ts",
