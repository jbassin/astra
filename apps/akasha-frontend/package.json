{
  "name": "@astra/akasha-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner && bun run scripts/build-search.ts",
    "start": "bun run server.ts",
    "typecheck": "bun run scripts/build-content.ts && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:content": "bun run scripts/build-content.ts"
  },
  "dependencies": {
    "@astra/config": "workspace:*",
    "@floating-ui/dom": "^1.7.6",
    "@astra/content-build": "workspace:*",
    "@astra/gothic": "workspace:*",
    "@astra/observe": "workspace:*",
    "@astra/ontology": "workspace:*",
    "@astra/site-kit": "workspace:*",
    "@astra/vellum-lang": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/react-router": "^1.170.7",
    "@tanstack/react-start": "^1.168.10",
    "@tweenjs/tween.js": "^25.0.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.13",
    "vite": "^6.3.6",
    "vitest": "^3.0.0"
  }
