  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.60.0",
    "vite": "8.1.3",
    "vitest": "^4.1.9"
