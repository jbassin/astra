{
  "alert": "astra Dagster daemon heartbeat missing",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "description": "The {{$daemon_type}} daemon last beat {{$value}} s ago (limit 600 s). Check: docker logs --tail 80 astra-dagster-daemon; the Dagster UI's Deployment > Daemons page.",
    "summary": "Dagster daemon {{$daemon_type}} has no heartbeat"
  },
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "disabled": false,
            "legend": "{{daemon_type}}",
            "name": "A",
            "query": "max by (daemon_type) (astra_dagster_daemon_heartbeat_age_seconds{\"service.name\"=\"node-exporter\"})"
          },
          "type": "promql"
        }
      ],
      "queryType": "promql"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "discord-ops"
          ],
          "matchType": "at_least_once",
          "name": "error",
          "op": "above",
          "recoveryTarget": null,
          "target": 600,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A Dagster daemon (sensor, scheduler, run queue, asset, backfill, ...) has written no heartbeat for 10 minutes. The daemons beat every 30 to 60 s and a deploy restarts them within a few minutes, so 10 minutes means the daemon is down or wedged and sensors (the Craig drop sensor) are not running. Source: astra-ops host-metrics, from the daemon_heartbeats table.",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "labels": {
    "host": "saffron",
    "severity": "error"
  },
  "notificationSettings": {
    "groupBy": [
      "daemon_type"
    ],
    "renotify": {
      "alertStates": [
        "firing"
      ],
      "enabled": true,
      "interval": "4h"
    }
  },
  "ruleType": "promql_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
