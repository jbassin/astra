// The fixture config with one invalid value in a block only TS reads: `orator.port` is a
// string. The Python loader must still load it; the TS loader and the whole-file check
// (Python `load_whole_config`) must reject it.

data {
    root "/srv/state"
}
heartwood {
    max-iterations 7
}
orator {
    port "not-a-port"
}
