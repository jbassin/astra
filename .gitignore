# Build output (all site-gen lands here; served by Caddy)
dist/

# Secrets & edge config
#   - real Caddyfile embeds a Cloudflare DNS token (faerrin gotcha); only the
#     .example is committed.
#   - SOPS age/PGP private keys never enter git; the encrypted secret file does.
Caddyfile
*.agekey

# SOPS secrets directory — deny everything, then re-allow only what's safe to
# commit. Makes it impossible to accidentally commit the age PRIVATE key
# (deploy/sops/age.key); the .sops.yaml recipient list and *.enc.* ciphertext
# are public and stay tracked. See deploy/sops/README.md.
deploy/sops/*
!deploy/sops/README.md
!deploy/sops/.sops.yaml
!deploy/sops/*.enc.yaml
!deploy/sops/*.enc.json

.env
.env.*
!.env.example

# SigNoz runtime artifacts — init-clickhouse downloads the histogram-quantile
# binary into this bind-mounted dir on `up`; it's regenerated, not source.
deploy/signoz/common/clickhouse/user_scripts/*
!deploy/signoz/common/clickhouse/user_scripts/.gitkeep

# Python (uv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Node / bun
node_modules/

# Rust (defensive: astra is two-toolchain, but guard against stray target/)
target/

# OS / editor cruft
.DS_Store
